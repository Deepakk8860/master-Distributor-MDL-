<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/alert_back"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/_20sp">


    <TextView
        android:id="@+id/msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sp"
        android:fontFamily="@font/medium"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/_3sp"
        android:text="Are you sure you want to submit requirements"
        android:textColor="#25233C"

        android:textSize="@dimen/_14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_25sp"
        android:layout_marginBottom="@dimen/_5sp"
        android:gravity="center">

        <Button
            android:id="@+id/no"
            style="@style/button"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_40sp"
            android:layout_marginStart="@dimen/_10sp"
            android:gravity="center"
            android:minWidth="@dimen/_80sp"
            android:paddingStart="@dimen/_20sp"
            android:paddingEnd="@dimen/_20sp"
            android:text="No"
            android:textSize="@dimen/_13sp" />


        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/yes"
            style="@style/buttonGreen"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_40sp"
            android:layout_marginEnd="@dimen/_10sp"
            android:gravity="center"
            android:minWidth="@dimen/_80sp"

            android:paddingStart="@dimen/_20sp"
            android:paddingEnd="@dimen/_20sp"
            android:text="Yes"
            android:textSize="@dimen/_13sp" />


    </LinearLayout>

</LinearLayout>
