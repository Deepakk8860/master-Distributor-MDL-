<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="model"
            type="com.android.masterdistributormdl.gskDistributor.view.home.TicketsModel" />
    </data>


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:orientation="vertical"
        android:theme="@style/MaterialTheme">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_100sp"
            android:background="#132D5F" />

        <LinearLayout
            android:id="@+id/headerLay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_15sp"
            android:paddingTop="@dimen/_15sp"
            android:paddingBottom="@dimen/_60sp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/back"
                android:layout_width="@dimen/_35sp"
                android:layout_height="@dimen/_35sp"
                android:background="@drawable/custom_trans_button"
                android:src="@drawable/arrow_left_white" />


            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_15sp"
                android:fontFamily="@font/medium"
                android:text="Tickets"
                android:textColor="@color/white"

                android:textSize="@dimen/_16sp" />
        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/_65sp">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/report_date"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/_20sp"
                        android:paddingTop="@dimen/_20sp"
                        android:paddingEnd="@dimen/_20sp"
                        android:paddingBottom="@dimen/_15sp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.8">

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/OutlinedBoxStyle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">


                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etStartDate"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:focusable="false"
                                        android:fontFamily="@font/normal"
                                        android:hint="From"
                                        android:importantForAutofill="no"
                                        android:inputType="textCapWords"
                                        android:paddingStart="@dimen/_12sp"
                                        android:paddingEnd="@dimen/_12sp"
                                        android:singleLine="true"
                                        android:textColor="#1D3667"
                                        android:textCursorDrawable="@drawable/color_cursor"
                                        android:textSize="@dimen/_11sp" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="@dimen/_17sp"
                                    android:layout_height="@dimen/_17sp"
                                    android:layout_gravity="center|end"
                                    android:layout_marginEnd="@dimen/_9sp"
                                    android:layout_marginBottom="@dimen/_6sp"
                                    android:src="@drawable/calender" />

                            </FrameLayout>

                            <View
                                android:layout_width="@dimen/_12sp"
                                android:layout_height="@dimen/_1sp" />

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.8">

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/OutlinedBoxStyle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">


                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etEndDate"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:focusable="false"
                                        android:fontFamily="@font/normal"
                                        android:hint="To"
                                        android:importantForAutofill="no"
                                        android:inputType="textCapWords"
                                        android:paddingStart="@dimen/_12sp"
                                        android:paddingEnd="@dimen/_12sp"
                                        android:singleLine="true"
                                        android:textColor="#1D3667"
                                        android:textCursorDrawable="@drawable/color_cursor"
                                        android:textSize="@dimen/_11sp" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="@dimen/_17sp"
                                    android:layout_height="@dimen/_17sp"
                                    android:layout_gravity="center|end"
                                    android:layout_marginEnd="@dimen/_9sp"
                                    android:layout_marginBottom="@dimen/_6sp"
                                    android:src="@drawable/calender" />

                            </FrameLayout>

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/search"
                                android:layout_width="@dimen/_27sp"
                                android:layout_height="@dimen/_27sp"
                                android:layout_gravity="center|end"
                                app:tint="#F86202"
                                android:layout_marginHorizontal="@dimen/_5sp"
                                android:layout_marginBottom="@dimen/_8sp"
                                android:src="@drawable/baseline_search_24" />

                        </LinearLayout>

                        <Button
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_45sp"
                            android:layout_marginBottom="@dimen/_5sp"
                            android:background="@drawable/login_button"
                            android:fontFamily="@font/bold"
                            android:gravity="center"
                            android:visibility="gone"
                            android:text="Search"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_14sp" />

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adapter="@{model.shopAdapter}"
                        android:background="@color/white"
                        android:clipToPadding="false"
                        android:paddingTop="@dimen/_12sp"
                        android:paddingBottom="@dimen/_10sp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/ticket_adapter" />



                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <TextView
            android:id="@+id/txtNoDataFound"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/no_support_requests_found"
            android:textSize="16sp"
            android:visibility="gone"
            android:gravity="center"
            android:layout_gravity="center"
            android:fontFamily="@font/medium"
            android:textColor="@color/gray_666666"/>

    </RelativeLayout>
</layout>
