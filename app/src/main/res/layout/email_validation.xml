<com.android.masterdistributormdl.gskDistributor.utils.CornorLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/_25sp"
    android:paddingTop="@dimen/_15sp"
    android:paddingEnd="@dimen/_25sp"
    android:paddingBottom="@dimen/_25sp"
    android:theme="@style/MaterialTheme"
    app:backgroundColor="@color/white"
    app:radiusTopLeft="@dimen/_25sp"
    app:radiusTopRight="@dimen/_25sp">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/_6sp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/medium"
            android:includeFontPadding="false"
            android:text="@string/email_continue"
            android:textColor="#991D3667"
            android:textAlignment="center"
            android:layout_below="@+id/close"
            android:layout_marginTop="@dimen/_8sp"
            android:textSize="@dimen/_14sp" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/close"
            android:layout_width="@dimen/_22sp"
            android:layout_height="@dimen/_22sp"
            android:layout_gravity="end"
            android:layout_alignParentEnd="true"
            android:src="@drawable/close" />

    </RelativeLayout>




    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sp"
        android:fontFamily="@font/normal"
        android:includeFontPadding="false"
        android:text="Email"
        android:visibility="gone"
        android:textColor="#991D3667"

        android:textSize="@dimen/_11sp" />

    <EditText
        android:id="@+id/email"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_45sp"
        android:layout_marginTop="@dimen/_10sp"
        android:background="@drawable/edt_bg_selector"
        android:fontFamily="@font/medium"
        android:hint="Email ID"
        android:importantForAutofill="no"
        android:inputType="textEmailAddress"
        android:paddingStart="@dimen/_12sp"
        android:paddingEnd="@dimen/_12sp"
        android:singleLine="true"
        android:textColor="#1D3667"
        android:textColorHint="#CCD2E3"
        android:textCursorDrawable="@drawable/color_cursor_email"
        android:textSize="@dimen/_12sp" />



    <Button
        android:id="@+id/save"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_50sp"
        android:background="@drawable/login_button"
        android:backgroundTint="@null"
        android:layout_marginTop="@dimen/_15sp"
        android:textColor="@color/white"
        android:text="Submit" />


</com.android.masterdistributormdl.gskDistributor.utils.CornorLinearLayout>
