<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">


    <LinearLayout
        android:id="@+id/clickLay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sp"
        android:layout_marginBottom="@dimen/_7sp"
        android:background="@color/white"
        android:orientation="vertical"
        android:paddingStart="@dimen/_20sp"
        android:paddingTop="@dimen/_20sp"
        android:paddingEnd="@dimen/_18sp"
        android:paddingBottom="@dimen/_20sp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/name"
                android:layout_width="0sp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAlignment="center"
                android:fontFamily="@font/medium"
                android:includeFontPadding="false"
                android:lineSpacingExtra="@dimen/_3sp"
                android:text="Graphics Design Package"
                android:textColor="#132D5F"
                android:textSize="@dimen/_10sp" />

            <TextView
                android:id="@+id/txtPrice"
                android:layout_width="0sp"
                android:layout_height="match_parent"
                android:fontFamily="@font/medium"
                android:layout_weight="1"
                android:gravity="center"
                android:textAlignment="center"
                android:includeFontPadding="false"
                android:lineSpacingExtra="@dimen/_3sp"
                android:text="djjdgjdbg"
                android:textColor="#132D5F"
                android:textSize="@dimen/_10sp" />

            <TextView
                android:id="@+id/txtCommission"
                android:layout_width="0sp"
                android:layout_height="match_parent"
                android:fontFamily="@font/medium"
                android:layout_weight="1"
                android:gravity="center"
                android:textAlignment="center"
                android:includeFontPadding="false"
                android:lineSpacingExtra="@dimen/_3sp"
                android:text="djjdgjdbg"
                android:textColor="#132D5F"
                android:textSize="@dimen/_10sp" />

            <TextView
                android:id="@+id/txtShopCommission"
                android:layout_width="0sp"
                android:layout_height="match_parent"
                android:fontFamily="@font/medium"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_gravity="center"
                android:textAlignment="center"
                android:includeFontPadding="false"
                android:lineSpacingExtra="@dimen/_3sp"
                android:text="djggjg"
                android:textColor="#132D5F"
                android:textSize="@dimen/_10sp" />

            <TextView
                android:id="@+id/txtDistCommission"
                android:layout_width="0sp"
                android:layout_height="match_parent"
                android:fontFamily="@font/medium"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_gravity="center"
                android:textAlignment="center"
                android:includeFontPadding="false"
                android:lineSpacingExtra="@dimen/_3sp"
                android:text="djggjg"
                android:textColor="#132D5F"
                android:textSize="@dimen/_10sp" />

        </LinearLayout>


    </LinearLayout>
</layout>
