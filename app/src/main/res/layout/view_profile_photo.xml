<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >
    <data>

        <variable
            name="model"
            type="com.android.masterdistributormdl.gskDistributor.view.home.ProfilePhotoModel" />
    </data>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black"
            >

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/back"
                    android:layout_width="@dimen/_20sp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/_15sp"
                    android:adjustViewBounds="true"
                    android:background="@drawable/custom_trans_button"
                    android:src="@drawable/back"
                    app:layout_constraintBottom_toBottomOf="@+id/toolbar"
                    app:layout_constraintStart_toStartOf="@+id/toolbar"
                    app:layout_constraintTop_toTopOf="@+id/toolbar" />

                <TextView
                    android:id="@+id/toolbar_Name"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/_15sp"
                    android:fontFamily="@font/medium"
                    android:text="@string/profile_photo"
                    android:textColor="#D3CACA"
                    android:textSize="18sp"
                     />


                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivEditProfilePhoto"
                    android:layout_width="@dimen/_19sp"
                    android:layout_height="@dimen/_19sp"
                    android:adjustViewBounds="true"
                    android:background="@drawable/custom_trans_button"
                    android:src="@drawable/baseline_edit_24"
                    android:layout_marginEnd="@dimen/_10sp"
                    android:layout_gravity="end"
                />





            </androidx.appcompat.widget.Toolbar>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivProfile"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_280sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:scaleType="centerCrop"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>


</layout>