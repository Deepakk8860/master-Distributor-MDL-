<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/alert_back">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/_15sp"
        android:paddingTop="@dimen/_15sp"
        android:paddingEnd="@dimen/_15sp"
        android:paddingBottom="@dimen/_2sp">

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/_30sp"
                android:layout_height="@dimen/_30sp"
                android:src="@drawable/logo_circle_app" />

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sp"
                android:fontFamily="@font/bold"
                android:lineSpacingExtra="@dimen/_2sp"
                android:text="Update GSK Onboard"
                android:textColor="#132D5F"
                android:textSize="@dimen/_14sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_3sp"
            android:layout_marginTop="@dimen/_8sp"
            android:fontFamily="@font/normal"
            android:lineSpacingExtra="@dimen/_2sp"
            android:text="@string/app_update_by_play"
            android:textColor="#132D5F"
            android:textSize="@dimen/_13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sp"
            android:layout_marginTop="@dimen/_15sp"
            android:background="#80DDE3E7" />

        <Button
            android:id="@+id/update"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_45sp"

            android:background="@drawable/custom_trans_button"
            android:fontFamily="@font/bold"
            android:includeFontPadding="false"
            android:letterSpacing=".03"
            android:text="Update"
            android:textAllCaps="false"
            android:textColor="#132D5F"
            android:textSize="@dimen/_14sp" />

    </LinearLayout>
</LinearLayout>


