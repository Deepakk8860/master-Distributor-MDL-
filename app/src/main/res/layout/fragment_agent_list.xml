<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:theme="@style/MaterialTheme">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#132D5F"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_15sp"
            android:paddingTop="@dimen/_15sp"
            android:paddingBottom="@dimen/_60sp">

            <ImageView
                android:id="@+id/back"
                android:layout_width="@dimen/_35sp"
                android:layout_height="@dimen/_35sp"
                android:background="@drawable/custom_trans_button"
                android:src="@drawable/arrow_left_white" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_15sp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/medium"
                    android:text="Agent List"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_16sp" />

                <TextView
                    android:id="@+id/count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_5sp"
                    android:fontFamily="@font/medium"
                    android:text="(0 Agents)"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_16sp" />

            </LinearLayout>
        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/_65sp">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <com.android.masterdistributormdl.gskDistributor.utils.CornorLinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:backgroundColor="@color/white"
                    app:radiusTopLeft="@dimen/_35sp"
                    app:radiusTopRight="@dimen/_35sp">

                    <!-- Add Agent full width card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardAddAgent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_20sp"
                        android:layout_marginTop="@dimen/_20sp"
                        android:layout_marginEnd="@dimen/_20sp"
                        android:layout_marginBottom="@dimen/_10sp"
                        app:cardBackgroundColor="#132D5F"
                        app:cardCornerRadius="@dimen/_15sp"
                        app:cardElevation="2sp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/_20sp"
                            android:paddingTop="@dimen/_15sp"
                            android:paddingEnd="@dimen/_20sp"
                            android:paddingBottom="@dimen/_15sp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/bold"
                                android:text="+ Add Agent"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_14sp" />

                            <ImageView
                                android:layout_width="@dimen/_20sp"
                                android:layout_height="@dimen/_20sp"
                                android:src="@drawable/arrow_right_orange"
                                app:tint="@color/white" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Search bar -->
                    <com.android.masterdistributormdl.gskDistributor.utils.CornorLinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/_20sp"
                        android:paddingEnd="@dimen/_20sp"
                        android:paddingBottom="@dimen/_5sp"
                        app:backgroundColor="@color/white">

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/edtSearch"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_45sp"
                            android:layout_marginVertical="@dimen/_6sp"
                            android:background="@drawable/search_background"
                            android:drawableStart="@drawable/baseline_search_24"
                            android:drawablePadding="@dimen/_8sp"
                            android:fontFamily="@font/medium"
                            android:hint="Search by Agent Name"
                            android:inputType="textCapWords"
                            android:paddingStart="@dimen/_15sp"
                            android:paddingEnd="@dimen/_15sp"
                            android:singleLine="true"
                            android:textColor="#1D3667"
                            android:textColorHint="@color/gray_666666"
                            android:textCursorDrawable="@drawable/color_cursor"
                            android:textSize="13sp"
                            app:drawableTint="#F86202" />
                    </com.android.masterdistributormdl.gskDistributor.utils.CornorLinearLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">


                        <!-- Recycler View -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToPadding="false"
                            android:paddingTop="@dimen/_10sp"
                            android:paddingBottom="@dimen/_60sp"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            tools:listitem="@layout/agent_item_adapter"
                            />

                        <!-- No Data Found -->
                        <TextView
                            android:id="@+id/txtNoDataFound"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/medium"
                            android:gravity="center"
                            android:visibility="gone"
                            android:paddingTop="@dimen/_40sp"
                            android:paddingBottom="@dimen/_40sp"
                            android:text="No agents found"
                            android:textColor="@color/gray_666666"
                            android:textSize="16sp" />

                    </RelativeLayout>


                </com.android.masterdistributormdl.gskDistributor.utils.CornorLinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </RelativeLayout>
</layout>
