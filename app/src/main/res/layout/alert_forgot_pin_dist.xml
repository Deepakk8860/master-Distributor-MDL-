<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/alert_back"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/_20sp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/close"
        android:layout_width="@dimen/_22sp"
        android:layout_height="@dimen/_22sp"
        android:layout_gravity="end"
        android:background="@drawable/custom_trans_button"

        android:src="@drawable/close" />


    <TextView
        android:id="@+id/msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sp"
        android:fontFamily="@font/normal"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/_3sp"
        android:text="Do you want to reset MPIN? We will send an OTP to your registered email address?"
        android:textColor="#1D3667"

        android:textSize="@dimen/_14sp" />

    <Button
        android:id="@+id/ok"
        style="@style/button"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_45sp"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/_15sp"
        android:layout_marginBottom="@dimen/_5sp"

        android:paddingStart="@dimen/_30sp"
        android:paddingEnd="@dimen/_30sp"
        android:text="OK" />

</LinearLayout>
