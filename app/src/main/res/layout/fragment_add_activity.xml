<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="model"
            type="com.android.masterdistributormdl.home.HomeModel" />
    </data>


    <RelativeLayout
        android:id="@+id/note_activity_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F4F0F0">

        <!-- Top Bar: Close Icon and Title -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivClose"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_alignParentStart="true"
            android:layout_marginStart="@dimen/_10sp"
            android:layout_marginTop="@dimen/_16sp"
            app:tint="@color/black"
            android:src="@drawable/iv_close" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/activity_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_16sp"
            android:layout_toEndOf="@id/ivClose"
            android:text="Activity with Deepak"
            android:layout_marginTop="@dimen/_12sp"
            android:fontFamily="@font/poppins_medium"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Note Section (Icon + Text) -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/note_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/ivClose"
            android:layout_marginTop="@dimen/_35sp"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_12sp">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="@dimen/_40sp"
                android:layout_height="@dimen/_40sp"
                android:background="@drawable/circle_shape"
                android:backgroundTint="#5E76F0"
                android:layout_gravity="center"
                android:gravity="center"
                >

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivTitleImage"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:tint="@color/white"
                    android:src="@drawable/iv_phone" />

            </androidx.appcompat.widget.LinearLayoutCompat>


            <TextView
                android:id="@+id/txtTitleName"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/_12sp"
                android:gravity="center_vertical"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:fontFamily="@font/poppins_medium"
                android:textStyle="bold" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/llNote"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_below="@id/note_section"
            android:layout_marginTop="@dimen/_20sp"
            android:background="@color/white"
            android:orientation="vertical">

            <!-- Note Input Box -->
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/note_input"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:gravity="top|start"
                android:fontFamily="@font/poppins_medium"
                android:hint="@string/add_optional_details_here"
                android:inputType="textMultiLine"
                android:paddingHorizontal="@dimen/_8sp"
                android:paddingVertical="@dimen/_8sp"
                android:textSize="14sp" />

        </androidx.appcompat.widget.LinearLayoutCompat>


        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/llTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/llNote"
            android:layout_marginTop="@dimen/_16sp"
            android:background="@drawable/background_client"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_12sp"
            android:paddingVertical="@dimen/_16sp">


            <!-- Time Row -->
            <RelativeLayout
                android:id="@+id/time_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivClock"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/clock" />  <!-- your clock icon -->

                <TextView
                    android:id="@+id/txtDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_20sp"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center_vertical"
                    android:text="Today 1:07 PM"
                    android:textColor="@color/black"
                    android:layout_toEndOf="@+id/ivClock"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sp"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center_vertical"
                    android:layout_toEndOf="@+id/txtDate"
                    android:text="1:27 PM"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivArrow"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="end"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/baseline_keyboard_arrow_down_24" />
            </RelativeLayout>

        </androidx.appcompat.widget.LinearLayoutCompat>


        <LinearLayout
            android:id="@+id/llAddActivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="@dimen/_16sp"
            android:layout_marginTop="@dimen/_25sp"
            android:layout_marginBottom="@dimen/_25sp"
            android:background="@drawable/login_button"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="12dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:src="@drawable/baseline_done_24"
                app:tint="@color/white" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txtButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/medium"
                android:text="@string/add_activity"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </LinearLayout>


    </RelativeLayout>

</layout>

