<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="model"
            type="com.android.masterdistributormdl.gskDistributor.view.home.BannerImageModel" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical"
        android:theme="@style/MaterialTheme">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#132D5F"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_12sp"
            android:paddingTop="@dimen/_15sp"

            android:paddingBottom="@dimen/_60sp">

            <ImageView
                android:id="@+id/back"
                android:layout_width="@dimen/_35sp"
                android:layout_height="@dimen/_35sp"
                android:background="@drawable/custom_trans_button"
                android:src="@drawable/arrow_left_white" />


            <TextView
                android:layout_width="0sp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_7sp"
                android:layout_weight="1"
                android:fontFamily="@font/medium"
                android:text="Promote"
                android:textColor="@color/white"

                android:textSize="@dimen/_16sp" />

        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/_70sp">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true">

                <com.android.masterdistributormdl.gskDistributor.utils.CornorLinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:backgroundColor="@color/white"
                    app:radiusTopLeft="@dimen/_35sp"
                    app:radiusTopRight="@dimen/_35sp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_45sp"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/_25sp"
                        android:paddingTop="@dimen/_2sp"
                        android:paddingEnd="@dimen/_25sp">

                        <TextView
                            android:id="@+id/earn"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:background="@drawable/tab_selector"
                            android:fontFamily="@font/bold"
                            android:gravity="center"
                            android:text="Promotional Images"
                            android:textColor="#1D3667"
                            android:textSize="@dimen/_13sp" />

                        <View
                            android:layout_width="0sp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />

                        <View
                            android:layout_width="@dimen/_1sp"
                            android:layout_height="match_parent"
                            android:layout_marginTop="@dimen/_7sp"
                            android:layout_marginBottom="@dimen/_7sp"
                            android:background="#CCD2E3" />

                        <View
                            android:layout_width="0sp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/potential"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/bold"
                            android:gravity="center"

                            android:text="Promotional Video"
                            android:textColor="#801D3667"

                            android:textSize="@dimen/_13sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#FFF9F3"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:paddingStart="@dimen/_20sp"
                        android:paddingTop="@dimen/_20sp"
                        android:paddingEnd="@dimen/_20sp"
                        android:paddingBottom="@dimen/_15sp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">

                                <com.google.android.material.textfield.TextInputLayout

                                    style="@style/OutlinedBoxStyle"

                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">


                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etStartDate"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:focusable="false"
                                        android:fontFamily="@font/normal"
                                        android:hint="From"
                                        android:importantForAutofill="no"
                                        android:inputType="textCapWords"

                                        android:paddingStart="@dimen/_15sp"
                                        android:paddingEnd="@dimen/_15sp"
                                        android:singleLine="true"
                                        android:textColor="#1D3667"
                                        android:textCursorDrawable="@drawable/color_cursor"

                                        android:textSize="@dimen/_12sp" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <ImageView
                                    android:layout_width="@dimen/_17sp"
                                    android:layout_height="@dimen/_17sp"
                                    android:layout_gravity="center|end"
                                    android:layout_marginEnd="@dimen/_9sp"
                                    android:layout_marginBottom="@dimen/_6sp"
                                    android:src="@drawable/calender" />

                            </FrameLayout>

                            <View
                                android:layout_width="@dimen/_12sp"
                                android:layout_height="@dimen/_1sp" />

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">

                                <com.google.android.material.textfield.TextInputLayout

                                    style="@style/OutlinedBoxStyle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">


                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etEndDate"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:focusable="false"
                                        android:fontFamily="@font/normal"
                                        android:hint="To"
                                        android:importantForAutofill="no"
                                        android:inputType="textCapWords"

                                        android:paddingStart="@dimen/_15sp"
                                        android:paddingEnd="@dimen/_15sp"
                                        android:singleLine="true"
                                        android:textColor="#1D3667"
                                        android:textCursorDrawable="@drawable/color_cursor"

                                        android:textSize="@dimen/_12sp" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <ImageView
                                    android:layout_width="@dimen/_17sp"
                                    android:layout_height="@dimen/_17sp"
                                    android:layout_gravity="center|end"
                                    android:layout_marginEnd="@dimen/_9sp"
                                    android:layout_marginBottom="@dimen/_6sp"
                                    android:src="@drawable/calender" />

                            </FrameLayout>

                        </LinearLayout>

                        <Button
                            android:id="@+id/search"
                            style="@style/button"


                            android:layout_marginBottom="@dimen/_5sp"

                            android:text="Search" />

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recPromotionalImage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adapter="@{model.promotionalAdapter}"
                        android:clipToPadding="false"
                        android:paddingTop="@dimen/_15sp"
                        android:paddingBottom="@dimen/_20sp"
                        android:layout_marginEnd="@dimen/_15sp"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:spanCount="2"
                        tools:listitem="@layout/adapter_images" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recPromotionalVideo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adapter="@{model.promotionalAdapterVideo}"
                        android:clipToPadding="false"
                        android:paddingTop="@dimen/_15sp"
                        android:paddingBottom="@dimen/_20sp"
                        android:visibility="gone"
                        android:layout_marginEnd="@dimen/_15sp"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:spanCount="2"
                        tools:listitem="@layout/adapter_video" />

                </com.android.masterdistributormdl.gskDistributor.utils.CornorLinearLayout>

            </androidx.core.widget.NestedScrollView>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>


    </RelativeLayout>
</layout>
