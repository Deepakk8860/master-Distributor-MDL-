<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="model"
            type="com.android.masterdistributormdl.gskDistributor.view.home.KycModel" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:theme="@style/MaterialTheme">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_150sp"
            android:background="#132D5F" />

        <LinearLayout
            android:id="@+id/topLay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_15sp"
            android:paddingTop="@dimen/_20sp"

            android:paddingBottom="@dimen/_20sp">

            <ImageView
                android:id="@+id/back"
                android:layout_width="@dimen/_35sp"
                android:layout_height="@dimen/_35sp"
                android:background="@drawable/custom_trans_button"
                android:src="@drawable/arrow_left_white" />


            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_15sp"
                android:fontFamily="@font/medium"
                android:text="KYC"
                android:textColor="@color/white"

                android:textSize="@dimen/_16sp" />
        </LinearLayout>


        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/topLay"
            android:clipToPadding="false"
            android:fillViewport="true">

            <com.android.masterdistributormdl.gskDistributor.utils.CornorLinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/_20sp"
                android:paddingTop="@dimen/_35sp"
                android:paddingEnd="@dimen/_20sp"
                android:paddingBottom="@dimen/_20sp"
                app:backgroundColor="#F0EEEF"
                app:radiusTopLeft="@dimen/_40sp"
                app:radiusTopRight="@dimen/_40sp">

                <TextView
                    android:id="@+id/message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_17sp"
                    android:fontFamily="@font/medium"
                    android:gravity="center"
                    android:text="According to @HaMMeRed answer here is pseudocode how should it works"
                    android:textColor="#132D5F"
                    android:textSize="@dimen/_15sp" />

                <RelativeLayout
                    android:id="@+id/relDistributorApp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_16sp"
                    android:layout_marginBottom="@dimen/_15sp"
                    android:visibility="gone"
                    android:background="@drawable/login_button"
                    android:layout_marginHorizontal="@dimen/_110sp"
                    android:orientation="horizontal"
                    >

                    <!-- Task Title -->
                    <TextView
                        android:id="@+id/txtDistributor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:paddingStart="@dimen/_10sp"
                        android:text="HELP"
                        android:drawablePadding="@dimen/_20sp"
                        android:layout_centerInParent="true"
                        android:paddingVertical="@dimen/_10sp"
                        android:layout_centerVertical="true"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />




                </RelativeLayout>


                <FrameLayout
                    android:id="@+id/panCardButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_50sp"
                    android:background="@color/white"
                    android:paddingStart="@dimen/_15sp"
                    android:paddingEnd="@dimen/_15sp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center|start"
                        android:fontFamily="@font/bold"
                        android:text="PAN Card Details"
                        android:textColor="#132D5F"
                        android:textSize="@dimen/_15sp" />

                    <ImageView
                        android:id="@+id/panIndicator"
                        android:layout_width="@dimen/_25sp"
                        android:layout_height="@dimen/_25sp"
                        android:layout_gravity="end|center"
                        android:src="@drawable/drop_down2" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/panViewLay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/_5sp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sp"
                        android:background="#4DCCD2E3" />

                    <LinearLayout
                        android:id="@+id/selectPanImage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_15sp"
                        android:layout_marginTop="@dimen/_15sp"
                        android:layout_marginEnd="@dimen/_15sp"
                        android:background="@drawable/dash_line2"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/_10sp">

                        <ImageView
                            android:layout_width="@dimen/_20sp"
                            android:layout_height="@dimen/_20sp"
                            android:src="@drawable/upload_attechment" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_5sp"

                            android:fontFamily="@font/medium"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="PAN Card Front Side"
                            android:textColor="#1D3667"
                            android:textSize="@dimen/_14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_5sp"
                            android:fontFamily="@font/normal"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="Upload Front Side of your PAN Card."
                            android:textColor="#801D3667"
                            android:textSize="@dimen/_11sp" />

                    </LinearLayout>


                    <FrameLayout
                        android:id="@+id/panImageLay"
                        android:layout_width="@dimen/_200sp"
                        android:layout_height="@dimen/_120sp"
                        android:layout_gravity="center"

                        android:layout_marginTop="@dimen/_20sp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/panImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/banner"
                            android:scaleType="fitXY"
                            app:shapeAppearance="@style/CornerSize10Percent" />

                        <ImageView
                            android:id="@+id/panClose"
                            android:layout_width="@dimen/_20sp"
                            android:layout_height="@dimen/_20sp"
                            android:layout_gravity="end"
                            android:layout_margin="@dimen/_5sp"
                            android:src="@drawable/close" />
                    </FrameLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_15sp"
                        android:layout_marginEnd="@dimen/_15sp"
                        android:orientation="vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/panNoLay"
                            style="@style/OutlinedBoxStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_20sp">


                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPanNo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/normal"
                                android:hint="PAN Card Number*"
                                android:inputType="textCapCharacters"
                                android:maxLength="10"
                                android:paddingStart="@dimen/_15sp"
                                android:paddingEnd="@dimen/_15sp"
                                android:singleLine="true"
                                android:textColor="#152B57"
                                android:textCursorDrawable="@drawable/color_cursor"
                                android:textSize="@dimen/_12sp" />

                        </com.google.android.material.textfield.TextInputLayout>


                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/panDobLay"
                            style="@style/OutlinedBoxStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">


                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDob"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:focusable="false"
                                android:fontFamily="@font/normal"
                                android:hint="Date of Birth*"
                                android:inputType="textCapCharacters"
                                android:maxLength="60"
                                android:paddingStart="@dimen/_15sp"
                                android:paddingEnd="@dimen/_15sp"
                                android:singleLine="true"

                                android:textColor="#152B57"
                                android:textCursorDrawable="@drawable/color_cursor"

                                android:textSize="@dimen/_12sp" />

                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>


                    <Button
                        android:id="@+id/panUpload"
                        style="@style/button"
                        android:layout_marginStart="@dimen/_15sp"
                        android:layout_marginTop="@dimen/_5sp"
                        android:layout_marginEnd="@dimen/_15sp"
                        android:layout_marginBottom="@dimen/_10sp"
                        android:text="Update" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_15sp" />

                <FrameLayout
                    android:id="@+id/aadharCardButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_50sp"
                    android:background="@color/white"
                    android:paddingStart="@dimen/_15sp"
                    android:paddingEnd="@dimen/_15sp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center|start"
                        android:fontFamily="@font/bold"
                        android:text="Aadhaar Details"
                        android:textColor="#132D5F"
                        android:textSize="@dimen/_15sp" />

                    <ImageView
                        android:id="@+id/aadharIndicator"
                        android:layout_width="@dimen/_25sp"
                        android:layout_height="@dimen/_25sp"
                        android:layout_gravity="end|center"
                        android:src="@drawable/drop_down2" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sp"
                        android:background="#4DCCD2E3" />

                    <LinearLayout
                        android:id="@+id/aadharViewLay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/_15sp"
                        android:paddingEnd="@dimen/_15sp"
                        android:paddingBottom="@dimen/_5sp">


                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="@dimen/_15sp"
                            android:fontFamily="@font/normal"
                            android:includeFontPadding="false"
                            android:text="Aadhaar Card Image - Front Side"
                            android:textColor="#991D3667"

                            android:textSize="@dimen/_11sp" />


                        <LinearLayout
                            android:id="@+id/selectAadharFrontImage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="@dimen/_15sp"

                            android:background="@drawable/dash_line2"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/_10sp">

                            <ImageView
                                android:layout_width="@dimen/_20sp"
                                android:layout_height="@dimen/_20sp"
                                android:src="@drawable/upload_attechment" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_5sp"

                                android:fontFamily="@font/medium"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:text="Aadhaar Card Front Side"
                                android:textColor="#1D3667"

                                android:textSize="@dimen/_14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_5sp"

                                android:fontFamily="@font/normal"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:text="Upload Front Side of your Aadhaar Card."
                                android:textColor="#801D3667"

                                android:textSize="@dimen/_11sp" />

                        </LinearLayout>

                        <FrameLayout
                            android:id="@+id/aadharFrontImageLay"
                            android:layout_width="@dimen/_200sp"
                            android:layout_height="@dimen/_120sp"
                            android:layout_gravity="center"

                            android:layout_marginTop="@dimen/_20sp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/aadharFrontImage"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/banner"
                                android:scaleType="fitXY"
                                app:shapeAppearance="@style/CornerSize10Percent" />

                            <ImageView
                                android:id="@+id/aadharFrontClose"
                                android:layout_width="@dimen/_20sp"
                                android:layout_height="@dimen/_20sp"
                                android:layout_gravity="end"
                                android:layout_margin="@dimen/_5sp"
                                android:src="@drawable/close" />
                        </FrameLayout>


                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/aadharNoLay"
                            style="@style/OutlinedBoxStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_20sp">


                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etAadharNo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:digits="12345 67890"
                                android:fontFamily="@font/normal"
                                android:hint="Aadhaar Card Number*"
                                android:inputType="number"
                                android:maxLength="14"
                                android:paddingStart="@dimen/_15sp"
                                android:paddingEnd="@dimen/_15sp"
                                android:singleLine="true"
                                android:textColor="#152B57"
                                android:textCursorDrawable="@drawable/color_cursor"
                                android:textSize="@dimen/_12sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <Button
                            android:id="@+id/btnAadharVerify"
                            style="@style/button"
                            android:visibility="gone"
                            android:layout_marginBottom="@dimen/_16sp"
                            android:text="Verify Aadhar" />

                        <RadioGroup
                            android:id="@+id/genderRG"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/_15sp"
                                android:fontFamily="@font/bold"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:text="Gender* :"
                                android:textColor="#1D3667"
                                android:textSize="@dimen/_14sp" />

                            <RadioButton
                                android:id="@+id/maleRB"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:buttonTint="#F86202"
                                android:fontFamily="@font/medium"
                                android:includeFontPadding="false"

                                android:text="Male"
                                android:textColor="#1D3667"
                                android:textSize="@dimen/_13sp" />

                            <RadioButton
                                android:id="@+id/femaleRB"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight=".8"
                                android:buttonTint="#1D3667"
                                android:fontFamily="@font/medium"
                                android:includeFontPadding="false"
                                android:minWidth="@dimen/_100sp"
                                android:text="Female"
                                android:textColor="#1D3667"
                                android:textSize="@dimen/_13sp" />

                        </RadioGroup>
                        <View android:layout_marginTop="@dimen/_10sp"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_1sp"
                            android:background="#4DCCD2E3" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="@dimen/_15sp"
                            android:fontFamily="@font/normal"
                            android:includeFontPadding="false"
                            android:text="Aadhaar Card Image - Back Side"
                            android:textColor="#991D3667"

                            android:textSize="@dimen/_11sp" />

                        <LinearLayout
                            android:id="@+id/selectAadharBackImage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="@dimen/_15sp"

                            android:background="@drawable/dash_line2"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/_20sp">

                            <ImageView
                                android:layout_width="@dimen/_20sp"
                                android:layout_height="@dimen/_20sp"
                                android:src="@drawable/upload_attechment" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_5sp"

                                android:fontFamily="@font/medium"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:text="Aadhaar Card Back Side"
                                android:textColor="#1D3667"

                                android:textSize="@dimen/_14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_5sp"

                                android:fontFamily="@font/normal"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:text="Upload Back Side of your Aadhaar Card."
                                android:textColor="#801D3667"

                                android:textSize="@dimen/_11sp" />

                        </LinearLayout>


                        <FrameLayout
                            android:id="@+id/aadharBackImageLay"
                            android:layout_width="@dimen/_200sp"
                            android:layout_height="@dimen/_120sp"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/_20sp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/aadharBackImage"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/banner"
                                android:scaleType="fitXY"
                                app:shapeAppearance="@style/CornerSize10Percent" />

                            <ImageView
                                android:id="@+id/aadharBackClose"
                                android:layout_width="@dimen/_20sp"
                                android:layout_height="@dimen/_20sp"
                                android:layout_gravity="end"
                                android:layout_margin="@dimen/_5sp"
                                android:src="@drawable/close" />
                        </FrameLayout>


                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/addLay"
                            style="@style/OutlinedBoxStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_15sp">


                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etAdd"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/normal"
                                android:hint="Address*"
                                android:inputType="textCapWords"
                                android:maxLength="60"
                                android:paddingStart="@dimen/_15sp"
                                android:paddingEnd="@dimen/_15sp"
                                android:singleLine="true"
                                android:textColor="#152B57"
                                android:textCursorDrawable="@drawable/color_cursor"
                                android:textSize="@dimen/_12sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/cityLay"
                            style="@style/OutlinedBoxStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etCity"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/normal"
                                android:hint="City*"
                                android:inputType="textCapWords"
                                android:paddingStart="@dimen/_15sp"
                                android:paddingEnd="@dimen/_15sp"
                                android:singleLine="true"
                                android:textColor="#1D3667"
                                android:textCursorDrawable="@drawable/color_cursor"
                                android:textSize="@dimen/_12sp" />

                        </com.google.android.material.textfield.TextInputLayout>


                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">


                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/stateLay"
                                style="@style/OutlinedBoxStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etState"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:focusable="false"
                                    android:fontFamily="@font/normal"
                                    android:hint="Select State*"
                                    android:inputType="textCapWords"
                                    android:paddingStart="@dimen/_15sp"
                                    android:paddingEnd="@dimen/_15sp"
                                    android:singleLine="true"
                                    android:textColor="#1D3667"
                                    android:textCursorDrawable="@drawable/color_cursor"
                                    android:textSize="@dimen/_12sp" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <ImageView
                                android:layout_width="@dimen/_27sp"
                                android:layout_height="@dimen/_22sp"
                                android:layout_gravity="end"
                                android:layout_marginTop="@dimen/_15sp"
                                android:layout_marginEnd="@dimen/_10sp"
                                android:src="@drawable/stage_down" />

                        </FrameLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/pincodeLay"
                            style="@style/OutlinedBoxStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">


                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPincode"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/normal"

                                android:hint="Pin Code*"
                                android:inputType="number"
                                android:maxLength="6"
                                android:paddingStart="@dimen/_15sp"
                                android:paddingEnd="@dimen/_15sp"
                                android:singleLine="true"

                                android:textColor="#152B57"
                                android:textCursorDrawable="@drawable/color_cursor"

                                android:textSize="@dimen/_12sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <Button
                            android:id="@+id/aadharUpload"
                            style="@style/button"
                            android:layout_marginTop="@dimen/_10sp"
                            android:layout_marginBottom="@dimen/_10sp"
                            android:text="Update" />

                    </LinearLayout>





                </LinearLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_15sp" />


                <FrameLayout
                    android:id="@+id/videoKycButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_50sp"
                    android:background="@color/white"
                    android:paddingStart="@dimen/_15sp"
                    android:paddingEnd="@dimen/_15sp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center|start"
                        android:fontFamily="@font/bold"
                        android:text="Video Kyc"
                        android:textColor="#132D5F"
                        android:textSize="@dimen/_15sp" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/arrowRight"
                        android:layout_width="@dimen/_22sp"
                        android:layout_height="@dimen/_22sp"
                        android:layout_gravity="end|center"
                        android:src="@drawable/arrow_right_orange" />
                </FrameLayout>






            </com.android.masterdistributormdl.gskDistributor.utils.CornorLinearLayout>


        </androidx.core.widget.NestedScrollView>


    </RelativeLayout>
</layout>
