<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <variable
            name="model"
            type="com.android.masterdistributormdl.gskDistributor.view.onboarding.OnboardModel" />
    </data>

    <LinearLayout
        android:id="@+id/mainLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/onbordStageLay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFF9F3"
            android:orientation="vertical"
            android:paddingStart="@dimen/_6sp"
            android:paddingTop="@dimen/_25sp"
            android:paddingEnd="@dimen/_6sp"
            android:paddingBottom="@dimen/_15sp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/logo"
                android:layout_width="@dimen/_100sp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sp"
                android:adjustViewBounds="true"
                android:src="@drawable/big_logo" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12sp"
                android:layout_marginTop="@dimen/_15sp"
                android:layout_marginEnd="@dimen/_12sp"
                android:gravity="center"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/radio1"
                    android:layout_width="@dimen/_20sp"
                    android:layout_height="@dimen/_20sp"
                    android:src="@drawable/stage_radio2" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/line1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:adjustViewBounds="true"
                    android:src="@drawable/stage_line2" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/radio2"
                    android:layout_width="@dimen/_20sp"
                    android:visibility="gone"
                    android:layout_height="@dimen/_20sp"
                    android:src="@drawable/stage_radio" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/line2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:adjustViewBounds="true"
                    android:src="@drawable/stage_line" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/radio3"
                    android:layout_width="@dimen/_20sp"
                    android:layout_height="@dimen/_20sp"
                    android:src="@drawable/stage_radio" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/line3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:visibility="gone"
                    android:adjustViewBounds="true"
                    android:src="@drawable/stage_line" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/radio4"
                    android:layout_width="@dimen/_20sp"
                    android:layout_height="@dimen/_20sp"
                    android:visibility="gone"
                    android:src="@drawable/stage_radio" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/line5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:visibility="gone"
                    android:adjustViewBounds="true"
                    android:src="@drawable/stage_line" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/radio5"
                    android:layout_width="@dimen/_20sp"
                    android:layout_height="@dimen/_20sp"
                    android:visibility="gone"
                    android:src="@drawable/stage_radio" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sp"
                android:layout_marginTop="@dimen/_10sp"
                android:layout_marginEnd="@dimen/_5sp">

                <TextView
                    android:id="@+id/basicDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="Basic\nDetails"
                    android:textColor="#1D3667"
                    android:textSize="@dimen/_10sp" />

                <View
                    android:layout_width="0sp"
                    android:layout_height="@dimen/_1sp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/medium"
                    android:gravity="center"
                    android:visibility="gone"
                    android:includeFontPadding="false"
                    android:text="Home/Business\nAddress"
                    android:textColor="#8A8A8A"
                    android:textSize="@dimen/_10sp" />

                <View
                    android:layout_width="0sp"
                    android:layout_height="@dimen/_1sp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/panCardDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/medium"
                    android:gravity="center"
                    android:visibility="gone"
                    android:includeFontPadding="false"
                    android:text="PAN Card\nDetails"
                    android:textColor="#8A8A8A"
                    android:textSize="@dimen/_10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/medium"
                    android:gravity="center"
                    android:visibility="gone"
                    android:includeFontPadding="false"
                    android:text="Home/Business\nAddress"
                    android:textColor="#8A8A8A"
                    android:textSize="@dimen/_10sp" />

                <View
                    android:layout_width="0sp"
                    android:layout_height="@dimen/_1sp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/aadharCardDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/medium"
                    android:gravity="center"
                    android:visibility="gone"
                    android:includeFontPadding="false"
                    android:text="Aadhaar Card\nDetails"
                    android:textColor="#8A8A8A"
                    android:textSize="@dimen/_10sp" />


                <View
                    android:layout_width="0sp"
                    android:layout_height="@dimen/_1sp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/videoKyc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/medium"
                    android:gravity="center"
                    android:visibility="gone"
                    android:includeFontPadding="false"
                    android:text="Video\nKYC"
                    android:textColor="#8A8A8A"
                    android:textSize="@dimen/_10sp" />

                <TextView
                    android:id="@+id/homeBusiAdd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="Home/Business\nAddress"
                    android:textColor="#8A8A8A"
                    android:textSize="@dimen/_10sp" />

            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="0sp"
            android:layout_weight="1">

            <include layout="@layout/onboard_basic" />
        </FrameLayout>


    </LinearLayout>

</layout>