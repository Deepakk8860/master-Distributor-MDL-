<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/mainLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end">

        <com.android.masterdistributormdl.gskDistributor.utils.CornorLinearLayout
            android:id="@+id/clickLay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sp"
            android:layout_marginBottom="@dimen/_10sp"
            android:orientation="vertical"
            android:paddingStart="@dimen/_15sp"
            android:paddingTop="@dimen/_12sp"
            android:paddingEnd="@dimen/_15sp"
            android:paddingBottom="@dimen/_7sp"
            app:backgroundColor="#F0EEEF"
            app:radiusBottomLeft="@dimen/_15sp"
            app:radiusBottomRight="@dimen/_15sp"
            app:radiusTopLeft="@dimen/_15sp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/medium"
                    android:text="Sed sollicitudin enim sit amet ipsum."
                    android:textColor="#1D3667"
                    android:textIsSelectable="true"

                    android:textSize="@dimen/_12sp" />


                <LinearLayout
                    android:id="@+id/attachmentLay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/_5sp"
                    android:layout_marginBottom="@dimen/_3sp"
                    android:background="@drawable/download_chat"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/_10sp"
                    android:paddingTop="@dimen/_6sp"
                    android:paddingEnd="@dimen/_8sp"
                    android:paddingBottom="@dimen/_5sp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/medium"
                        android:includeFontPadding="false"
                        android:text="Download"
                        android:textColor="#1D3667"
                        android:textSize="@dimen/_9sp" />

                    <ImageView
                        android:layout_width="@dimen/_13sp"
                        android:layout_height="@dimen/_13sp"
                        android:layout_marginStart="@dimen/_4sp"
                        android:src="@drawable/download_ticket" />
                </LinearLayout>

                <TextView
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/_3sp"
                    android:fontFamily="@font/medium"

                    android:text="1 Nov 2022"
                    android:textColor="#801D3667"

                    android:textSize="@dimen/_9sp" />

            </LinearLayout>


        </com.android.masterdistributormdl.gskDistributor.utils.CornorLinearLayout>

    </LinearLayout>


</layout>
