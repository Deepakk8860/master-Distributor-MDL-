<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="model"
            type="com.android.masterdistributormdl.gskDistributor.view.home.ReportDownloadModel" />
    </data>


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:theme="@style/MaterialTheme">

        <LinearLayout
            android:id="@+id/headerLay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#132D5F"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_15sp"
            android:paddingTop="@dimen/_15sp"
            android:paddingBottom="@dimen/_60sp">

            <ImageView
                android:id="@+id/back"
                android:layout_width="@dimen/_35sp"
                android:layout_height="@dimen/_35sp"
                android:background="@drawable/custom_trans_button"
                android:src="@drawable/arrow_left_white" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_15sp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/medium"
                android:text="Customer Report"
                android:textColor="@color/white"
                android:textSize="@dimen/_16sp" />

            <TextView
                android:id="@+id/count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sp"
                android:fontFamily="@font/normal"
                android:hint="0 Customer"
                android:text="@{model.itemCount}"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textSize="@dimen/_12sp" />

        </androidx.appcompat.widget.LinearLayoutCompat>






        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/_65sp"

            >

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <com.android.masterdistributormdl.gskDistributor.utils.CornorLinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:backgroundColor="@color/white"
                    app:radiusTopLeft="@dimen/_35sp"
                    app:radiusTopRight="@dimen/_35sp">

                    <com.android.masterdistributormdl.gskDistributor.utils.CornorLinearLayout
                        android:id="@+id/cornerLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/_20sp"
                        android:paddingTop="@dimen/_20sp"
                        android:paddingEnd="@dimen/_20sp"
                        android:paddingBottom="@dimen/_15sp"
                        app:backgroundColor="#FFF9F3"
                        app:radiusTopLeft="@dimen/_35sp"
                        app:radiusTopRight="@dimen/_35sp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.8">

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/OutlinedBoxStyle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">


                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etStartDate"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:focusable="false"
                                        android:fontFamily="@font/normal"
                                        android:hint="From"
                                        android:importantForAutofill="no"
                                        android:inputType="textCapWords"
                                        android:paddingStart="@dimen/_12sp"
                                        android:paddingEnd="@dimen/_12sp"
                                        android:singleLine="true"
                                        android:textColor="#1D3667"
                                        android:textCursorDrawable="@drawable/color_cursor"
                                        android:textSize="@dimen/_11sp" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="@dimen/_17sp"
                                    android:layout_height="@dimen/_17sp"
                                    android:layout_gravity="center|end"
                                    android:layout_marginEnd="@dimen/_9sp"
                                    android:layout_marginBottom="@dimen/_6sp"
                                    android:src="@drawable/calender" />

                            </FrameLayout>

                            <View
                                android:layout_width="@dimen/_12sp"
                                android:layout_height="@dimen/_1sp" />

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.8">

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/OutlinedBoxStyle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">


                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etEndDate"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:focusable="false"
                                        android:fontFamily="@font/normal"
                                        android:hint="To"
                                        android:importantForAutofill="no"
                                        android:inputType="textCapWords"
                                        android:paddingStart="@dimen/_12sp"
                                        android:paddingEnd="@dimen/_12sp"
                                        android:singleLine="true"
                                        android:textColor="#1D3667"
                                        android:textCursorDrawable="@drawable/color_cursor"
                                        android:textSize="@dimen/_11sp" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="@dimen/_17sp"
                                    android:layout_height="@dimen/_17sp"
                                    android:layout_gravity="center|end"
                                    android:layout_marginEnd="@dimen/_9sp"
                                    android:layout_marginBottom="@dimen/_6sp"
                                    android:src="@drawable/calender" />

                            </FrameLayout>

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/search"
                                android:layout_width="@dimen/_27sp"
                                android:layout_height="@dimen/_27sp"
                                android:layout_gravity="center|end"
                                app:tint="#F86202"
                                android:layout_marginHorizontal="@dimen/_5sp"
                                android:layout_marginBottom="@dimen/_8sp"
                                android:src="@drawable/baseline_search_24" />

                        </LinearLayout>

                        <Button
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_45sp"
                            android:layout_marginBottom="@dimen/_5sp"
                            android:background="@drawable/login_button"
                            android:fontFamily="@font/bold"
                            android:gravity="center"
                            android:visibility="gone"
                            android:text="Search"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_14sp" />

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/edtSearch"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_45sp"
                            android:background="@drawable/search_background"
                            android:fontFamily="@font/medium"
                            android:layout_marginVertical="@dimen/_6sp"
                            android:layout_marginEnd="@dimen/_20sp"
                            android:hint="Search by Customer Name"
                            android:visibility="gone"
                            android:drawableTint="#F86202"
                            android:drawablePadding="@dimen/_8sp"
                            android:inputType="textCapWords"
                            android:drawableStart="@drawable/baseline_search_24"
                            android:paddingStart="@dimen/_15sp"
                            android:paddingEnd="@dimen/_15sp"
                            android:singleLine="true"
                            android:textColor="#1D3667"
                            android:textColorHint="@color/gray_666666"
                            android:textCursorDrawable="@drawable/color_cursor"
                            android:textSize="13sp" />


                    </com.android.masterdistributormdl.gskDistributor.utils.CornorLinearLayout>

                    <!--visibility=@{model.detailsLay}-->
                    <LinearLayout
                        android:id="@+id/detailsLay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_20sp"
                        android:layout_marginTop="@dimen/_15sp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/bold"
                            android:text="Customer Details"
                            android:textColor="#132D5F"
                            android:textSize="@dimen/_15sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_3sp"
                            android:fontFamily="@font/normal"
                            android:hint="0 Shops"
                            android:text="@{model.itemCount}"
                            android:textColor="#B31D3667"
                            android:textColorHint="#B31D3667"
                            android:textSize="@dimen/_12sp" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12sp"
                        android:adapter="@{model.reportDownloadAdapter}"
                        android:clipToPadding="false"
                        android:paddingBottom="@dimen/_60sp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/download_adapter" />

                    <TextView
                        android:id="@+id/txtNoDataFound"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/no_customer_record_found"
                        android:textSize="16sp"
                        android:visibility="gone"
                        android:gravity="center"
                        android:fontFamily="@font/medium"
                        android:textColor="@color/gray_666666"/>
                </com.android.masterdistributormdl.gskDistributor.utils.CornorLinearLayout>

            </androidx.core.widget.NestedScrollView>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <LinearLayout
            android:id="@+id/downloadReport"
            android:layout_width="@dimen/_55sp"
            android:layout_height="@dimen/_55sp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="@dimen/_7sp"
            android:layout_marginBottom="@dimen/_7sp"
            android:background="@drawable/download_circle"
            android:elevation="@dimen/_5sp"
            android:gravity="center"
            android:orientation="vertical">


            <ImageView
                android:layout_width="@dimen/_25sp"
                android:layout_height="@dimen/_25sp"
                android:src="@drawable/download" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/_5sp"
                android:fontFamily="@font/medium"
                android:includeFontPadding="false"
                android:text="Download"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_8sp" />


        </LinearLayout>


    </RelativeLayout>
</layout>
