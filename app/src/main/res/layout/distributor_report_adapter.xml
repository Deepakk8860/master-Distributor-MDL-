<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <com.google.android.material.card.MaterialCardView

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_20sp"
        android:layout_marginTop="@dimen/_8sp"
        android:layout_marginEnd="@dimen/_20sp"
        android:layout_marginBottom="@dimen/_8sp"
        android:theme="@style/Theme.MaterialComponents.DayNight.DarkActionBar"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="@dimen/_25sp"
        app:cardElevation="0sp"
        app:strokeColor="#4D1D3667"
        app:strokeWidth="@dimen/_1sp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#4DFFF9F3"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_20sp"
                android:paddingTop="@dimen/_17sp"
                android:paddingEnd="@dimen/_18sp"
                android:paddingBottom="@dimen/_7sp">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="0sp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/medium"
                            android:layout_weight="1"
                            android:includeFontPadding="false"
                            android:layout_marginTop="@dimen/_5sp"
                            android:textColor="#132D5F"
                            android:text="@string/shop_name"
                            android:textSize="16sp" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/shop"
                            android:layout_width="0sp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/bold"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:textAlignment="textEnd"
                            android:layout_marginHorizontal="@dimen/_5sp"
                            android:layout_marginTop="@dimen/_5sp"
                            android:textColor="#F86202"
                            android:textSize="16sp" />

                    </androidx.appcompat.widget.LinearLayoutCompat>



                    <TextView
                        android:id="@+id/address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sp"
                        android:fontFamily="@font/medium"
                        android:includeFontPadding="false"
                        android:visibility="gone"
                        android:text="H-183 Noida Sector 63 -(UP) 201301,"
                        android:textColor="#B31D3667"

                        android:textSize="@dimen/_10sp" />

                </androidx.appcompat.widget.LinearLayoutCompat>



            </LinearLayout>


            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_1sp"
                android:visibility="gone"
                android:background="#4D1D3667" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/_20sp"
                android:paddingEnd="@dimen/_20sp"
                android:paddingBottom="@dimen/_15sp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0sp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/normal"
                        android:text="Status :"
                        android:textColor="#1B2F56"
                        android:textSize="@dimen/_12sp" />

                    <TextView
                        android:id="@+id/status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/medium"
                        android:includeFontPadding="false"
                        android:text="● Active"
                        android:textColor="#B31D3667"
                        android:textSize="@dimen/_13sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0sp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/normal"
                        android:text="Distributor Name :"
                        android:textColor="#1B2F56"
                        android:textSize="@dimen/_12sp" />

                    <TextView
                        android:id="@+id/name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/medium"


                        android:text="Android App"
                        android:textColor="#1B2F56"

                        android:textSize="@dimen/_12sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0sp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/normal"

                        android:text="Mobile No :"
                        android:textColor="#1B2F56"

                        android:textSize="@dimen/_12sp" />

                    <TextView
                        android:id="@+id/mobile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/medium"


                        android:text="98767834556"
                        android:textColor="#1B2F56"

                        android:textSize="@dimen/_12sp" />

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0sp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/normal"

                        android:text="Email :"
                        android:textColor="#1B2F56"

                        android:textSize="@dimen/_12sp" />

                    <TextView
                        android:id="@+id/email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/medium"
                        android:text="98767834556"
                        android:textColor="#1B2F56"
                        android:textSize="@dimen/_12sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/shopIdLay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0sp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/normal"
                        android:text="Distributor ID :"
                        android:textColor="#1B2F56"
                        android:textSize="@dimen/_12sp" />

                    <TextView
                        android:id="@+id/shopid"
                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"
                        android:fontFamily="@font/medium"

                        android:text="1"
                        android:textColor="#1B2F56"

                        android:textSize="@dimen/_12sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0sp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/normal"

                        android:text="Activation Date :"
                        android:textColor="#1B2F56"

                        android:textSize="@dimen/_12sp" />

                    <TextView
                        android:id="@+id/date"
                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"
                        android:fontFamily="@font/medium"

                        android:text="1 Nov 2022"
                        android:textColor="#1B2F56"

                        android:textSize="@dimen/_12sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/addedByLay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0sp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/normal"

                        android:text="Added By :"
                        android:textColor="#1B2F56"

                        android:textSize="@dimen/_12sp" />

                    <TextView
                        android:id="@+id/addedBy"
                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"
                        android:fontFamily="@font/medium"

                        android:text="Android App"
                        android:textColor="#1B2F56"

                        android:textSize="@dimen/_12sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0sp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/normal"
                        android:text="Consumers :"
                        android:textColor="#1B2F56"
                        android:textSize="@dimen/_12sp" />

                    <TextView
                        android:id="@+id/clients"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/medium"
                        android:textColor="#1877F2"
                        android:textSize="@dimen/_12sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0sp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/normal"
                        android:text="Retailers :"
                        android:textColor="#1B2F56"
                        android:textSize="@dimen/_12sp" />

                    <TextView
                        android:id="@+id/retailers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/medium"
                        android:textColor="#1877F2"
                        android:textSize="@dimen/_12sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0sp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/normal"
                        android:text="Orders :"
                        android:textColor="#1B2F56"
                        android:textSize="@dimen/_12sp" />

                    <TextView
                        android:id="@+id/orders"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/medium"
                        android:textColor="#34A853"
                        android:textSize="@dimen/_12sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/earningLay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0sp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/normal"
                        android:text="Your Earning :"
                        android:textColor="#1B2F56"
                        android:textSize="@dimen/_12sp" />

                    <TextView
                        android:id="@+id/earning"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/medium"
                        android:textColor="#F86202"
                        android:textSize="@dimen/_12sp" />

                </LinearLayout>
            </LinearLayout>

            <View
                android:id="@+id/line"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_1sp"
                android:visibility="gone"
                android:background="#4D1D3667" />


            <LinearLayout
                android:id="@+id/viewCertificate"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40sp"
                android:background="@drawable/custom_trans_button"
                android:gravity="center"
                android:visibility="gone"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtViewCertificate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/medium"
                    android:text="View Certificate"
                    android:textColor="#F86202"
                    android:textSize="@dimen/_11sp" />

                <ImageView
                    android:id="@+id/ivArrowLeft"
                    android:layout_width="@dimen/_15sp"
                    android:layout_height="@dimen/_15sp"
                    android:layout_marginStart="@dimen/_8sp"
                    android:src="@drawable/arrow_right_orange" />

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
