<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/clickLay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
android:paddingBottom="@dimen/_15sp"
        android:orientation="vertical"

        android:paddingStart="@dimen/_20sp"
        android:paddingTop="@dimen/_15sp"
        android:paddingEnd="@dimen/_20sp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/status"
                android:layout_width="0sp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/bold"

                android:text="What a great idea!"
                android:textColor="#1D3667"

                android:textSize="@dimen/_13sp" />

            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/medium"
                android:text="20 Sep 2022"
                android:textColor="#801D3667"

                android:textSize="@dimen/_11sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_7sp"
            android:fontFamily="@font/normal"
            android:maxLines="2"
            android:text="There are many variations passhave suffered altera, variations passhave suffered altera,"
            android:textColor="#991B2F56"
            android:textSize="@dimen/_11sp" />


    </LinearLayout>

</layout>