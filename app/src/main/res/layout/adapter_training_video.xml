<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_12sp"
        android:background="@drawable/background_main_video_banner"
        android:padding="@dimen/_10sp">

        <TextView
            android:id="@+id/txtSerialNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/bold"
            android:textColor="#231F20"
            android:textSize="18sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivPlayDemo"
            android:layout_width="@dimen/_24sp"
            android:layout_height="@dimen/_24sp"
            android:layout_marginTop="@dimen/_5sp"
            android:src="@drawable/iv_play_red"
            app:layout_constraintStart_toStartOf="@+id/txtSerialNumber"
            app:layout_constraintTop_toBottomOf="@+id/txtSerialNumber" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_8sp"
            android:fontFamily="@font/normal"
            android:textColor="@color/gray_666666"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="@+id/ivPlayDemo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivPlayDemo"
            app:layout_constraintTop_toTopOf="@+id/ivPlayDemo" />


        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivVideoBanner"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="@dimen/_16sp"
            android:scaleType="fitXY"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtTitle" />


        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivPlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="@dimen/_3sp"
            android:scaleType="fitXY"
            android:src="@drawable/iv_play"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ivVideoBanner" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
