                    android:layout_width="@dimen/_50sp"
                    android:layout_height="@dimen/_50sp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/userImage"
                        android:layout_width="@dimen/_45sp"
                        android:layout_height="@dimen/_45sp"
                        android:src="@drawable/logo_app"
                        app:shapeAppearance="@style/CornerSize10Percent" />

                    <ImageView
                        android:layout_width="@dimen/_15sp"
                        android:layout_height="@dimen/_15sp"
                        android:layout_gravity="bottom|end"
                        android:visibility="gone"
                        android:src="@drawable/profile_edit" />

                </FrameLayout>

