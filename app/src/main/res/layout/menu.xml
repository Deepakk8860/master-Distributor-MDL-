            android:layout_height="match_parent"

            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/close"
                android:layout_width="@dimen/_25sp"
                android:layout_height="@dimen/_25sp"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/_10sp"
                android:layout_marginEnd="@dimen/_10sp"
                android:background="@drawable/custom_trans_button"

                android:src="@drawable/close_menu" />

            <androidx.appcompat.widget.LinearLayoutCompat
