<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="model"
            type="com.android.masterdistributormdl.gskDistributor.view.home.TicketInfoModel" />
    </data>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:theme="@style/MaterialTheme">

        <LinearLayout
            android:id="@+id/topLay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#132D5F"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_15sp"
            android:paddingTop="@dimen/_15sp"
            android:paddingBottom="@dimen/_60sp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/back"
                android:layout_width="@dimen/_35sp"
                android:layout_height="@dimen/_35sp"
                android:background="@drawable/custom_trans_button"
                android:src="@drawable/arrow_left_white" />


            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_15sp"
                android:fontFamily="@font/medium"
                android:text="View Details"
                android:textColor="@color/white"

                android:textSize="@dimen/_16sp" />
        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/_minus30sp"
            android:layout_weight="1">

            <com.android.masterdistributormdl.gskDistributor.utils.CornorNestedScrollView
                android:id="@+id/scrollViewLay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                app:backgroundColor="#F0EEEF"
                app:radiusTopLeft="@dimen/_30sp"
                app:radiusTopRight="@dimen/_30sp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/_20sp"
                        android:paddingTop="@dimen/_25sp"
                        android:paddingEnd="@dimen/_20sp"
                        android:paddingBottom="@dimen/_15sp">

                        <LinearLayout
                            android:layout_width="0sp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">


                            <TextView
                                android:id="@+id/ticketId"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/bold"
                                android:includeFontPadding="false"
                                android:text="Ticket ID: 32165498"
                                android:textColor="#1D3667"
                                android:textSize="@dimen/_13sp" />

                            <TextView
                                android:id="@+id/date"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_3sp"
                                android:fontFamily="@font/medium"
                                android:includeFontPadding="false"
                                android:text="Created Date: 11/05/2022"
                                android:textColor="#B31D3667"
                                android:textSize="@dimen/_11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/bold"
                                android:includeFontPadding="false"
                                android:text="Active"
                                android:textColor="#34A853"
                                android:textSize="@dimen/_13sp" />

                            <TextView

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_3sp"
                                android:fontFamily="@font/medium"
                                android:includeFontPadding="false"
                                android:text="Status"
                                android:textColor="#B31D3667"
                                android:textSize="@dimen/_11sp" />
                        </LinearLayout>

                    </LinearLayout>


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sp"
                        android:layout_marginStart="@dimen/_20sp"
                        android:layout_marginEnd="@dimen/_20sp"
                        android:background="#1A1D3667" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/_20sp"
                        android:paddingTop="@dimen/_15sp"
                        android:paddingBottom="@dimen/_15sp">

                        <TextView

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:fontFamily="@font/medium"
                            android:includeFontPadding="false"
                            android:text="Ticket Type"
                            android:textColor="#B31D3667"
                            android:textSize="@dimen/_11sp" />

                        <TextView
                            android:id="@+id/type"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_2sp"
                            android:fontFamily="@font/bold"
                            android:includeFontPadding="false"
                            android:text="App related issues"
                            android:textColor="#1D3667"
                            android:textSize="@dimen/_13sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sp"
                        android:layout_marginStart="@dimen/_20sp"
                        android:layout_marginEnd="@dimen/_20sp"
                        android:background="#1A1D3667" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/_20sp"
                        android:paddingTop="@dimen/_15sp"
                        android:paddingBottom="@dimen/_15sp">

                        <TextView

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:fontFamily="@font/medium"
                            android:includeFontPadding="false"
                            android:text="Ticket Subject"
                            android:textColor="#B31D3667"
                            android:textSize="@dimen/_11sp" />

                        <TextView
                            android:id="@+id/subject"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_2sp"
                            android:fontFamily="@font/bold"
                            android:includeFontPadding="false"
                            android:text="App related issues"
                            android:textColor="#1D3667"
                            android:textSize="@dimen/_13sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sp"
                        android:layout_marginStart="@dimen/_20sp"
                        android:layout_marginEnd="@dimen/_20sp"
                        android:background="#1A1D3667" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/_20sp"
                        android:paddingTop="@dimen/_15sp"
                        android:paddingBottom="@dimen/_10sp">

                        <TextView

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:fontFamily="@font/medium"
                            android:includeFontPadding="false"
                            android:text="Description"
                            android:textColor="#B31D3667"
                            android:textSize="@dimen/_11sp" />

                        <TextView
                            android:id="@+id/description"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_2sp"
                            android:fontFamily="@font/medium"
                            android:includeFontPadding="false"
                            android:text="There are many variations passhave suffered altera, variations passhave suffered altera,"
                            android:textColor="#CC1B2F56"
                            android:textSize="@dimen/_13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/attachmentLay"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_45sp"
                        android:layout_marginStart="@dimen/_20sp"
                        android:layout_marginTop="@dimen/_10sp"
                        android:layout_marginEnd="@dimen/_20sp"
                        android:background="@drawable/download_attechment"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/bold"
                            android:includeFontPadding="false"
                            android:text="View Attachment"
                            android:textColor="#1D3667"
                            android:textSize="@dimen/_12sp" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/_20sp"
                            android:layout_height="@dimen/_20sp"
                            android:layout_marginStart="@dimen/_2sp"
                            android:visibility="gone"
                            android:src="@drawable/download_ticket" />
                    </LinearLayout>

                    <com.android.masterdistributormdl.gskDistributor.utils.CornorLinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="@dimen/_25sp"
                        android:orientation="vertical"
                        app:backgroundColor="@color/white"
                        app:radiusTopRight="@dimen/_30sp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/_20sp"
                            android:paddingTop="@dimen/_15sp"
                            android:paddingEnd="@dimen/_20sp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/medium"

                                android:text="Conversation"
                                android:textColor="#132D5F"

                                android:textSize="@dimen/_14sp" />


                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:adapter="@{model.chatAdapter}"
                            android:nestedScrollingEnabled="true"
                            android:paddingTop="@dimen/_10sp"
                            android:paddingBottom="@dimen/_10sp"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            tools:itemCount="2"
                            tools:listitem="@layout/chat_adapter" />

                        <TextView
                            android:id="@+id/viewMore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"

                            android:fontFamily="@font/medium"
                            android:includeFontPadding="false"
                            android:padding="@dimen/_10sp"
                            android:text="@string/view_more"
                            android:textColor="#03A9F4"
                            android:textSize="@dimen/_11sp" />

                    </com.android.masterdistributormdl.gskDistributor.utils.CornorLinearLayout>

                </LinearLayout>

            </com.android.masterdistributormdl.gskDistributor.utils.CornorNestedScrollView>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>


        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/chatLay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:padding="@dimen/_10sp"
            android:paddingStart="@dimen/_12sp"
            android:paddingEnd="@dimen/_12sp"
            app:elevation="@dimen/_5sp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/chatImageLay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/_12sp"
                    android:layout_marginBottom="@dimen/_15sp"
                    android:theme="@style/Theme.MaterialComponents.DayNight.DarkActionBar"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/_10sp"
                    app:cardElevation="@dimen/_3sp"
                    app:strokeColor="#4DECECEC"
                    app:strokeWidth="@dimen/_1sp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/chatImage"
                        android:layout_width="@dimen/_100sp"
                        android:layout_height="@dimen/_100sp"
                        android:minHeight="@dimen/_60sp"
                        android:scaleType="centerCrop" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/close"
                        android:layout_width="@dimen/_20sp"
                        android:layout_height="@dimen/_20sp"
                        android:layout_gravity="end"
                        android:layout_margin="@dimen/_7sp"
                        android:src="@drawable/close" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <FrameLayout
                        android:layout_width="0sp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/et_message"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/reply_edit"
                            android:fontFamily="@font/medium"

                            android:hint="Type Message..."
                            android:inputType="textCapSentences|textMultiLine"
                            android:lineSpacingExtra="@dimen/_3sp"
                            android:maxHeight="@dimen/_80sp"
                            android:minHeight="@dimen/_45sp"
                            android:paddingStart="@dimen/_12sp"
                            android:paddingTop="@dimen/_10sp"
                            android:paddingEnd="@dimen/_40sp"
                            android:paddingBottom="@dimen/_10sp"
                            android:textColor="#1D3667"
                            android:textColorHint="#CCD2E3"
                            android:textCursorDrawable="@drawable/color_cursor"
                            android:textSize="@dimen/_12sp" />


                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/attachment"
                            android:layout_width="@dimen/_25sp"
                            android:layout_height="@dimen/_25sp"
                            android:layout_gravity="center|end"
                            android:layout_marginEnd="@dimen/_7sp"
                            android:background="@drawable/custom_trans_button"
                            android:src="@drawable/attechment_chat" />
                    </FrameLayout>

                    <View
                        android:layout_width="@dimen/_12sp"
                        android:layout_height="match_parent" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/sendChat"
                        android:layout_width="@dimen/_40sp"
                        android:layout_height="@dimen/_40sp"
                        android:layout_gravity="center"
                        android:src="@drawable/send_chat" />

                </LinearLayout>
            </LinearLayout>


        </com.google.android.material.appbar.AppBarLayout>


    </LinearLayout>
</layout>
