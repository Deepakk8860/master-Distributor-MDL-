<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/alert_back"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/_20sp">


    <TextView
        android:id="@+id/msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sp"
        android:fontFamily="@font/medium"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/_3sp"
        android:text="Are you sure you want to logout?"
        android:textColor="#25233C"

        android:textSize="@dimen/_14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_25sp"
        android:layout_marginBottom="@dimen/_5sp"
        android:gravity="center">

        <Button
            android:id="@+id/cancel"
            style="@style/button"
            android:layout_width="@dimen/_90sp"
            android:layout_height="@dimen/_40sp"
            android:gravity="center"
            android:text="Cancel"
            android:textSize="@dimen/_13sp" />

        <View
            android:layout_width="@dimen/_50sp"
            android:layout_height="@dimen/_1sp" />

        <Button
            android:id="@+id/logout"
            style="@style/button"
            android:layout_width="@dimen/_90sp"
            android:layout_height="@dimen/_40sp"
            android:backgroundTint="#34A853"
            android:gravity="center"
            android:text="Logout"
            android:textSize="@dimen/_13sp" />


    </LinearLayout>

</LinearLayout>
