<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="model"
            type="com.android.masterdistributormdl.home.HomeModel" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F4F0F0"
            android:layout_above="@+id/btnSave"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_60sp"
                    android:background="@color/white"
                    android:elevation="@dimen/_3sp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/backButton"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:layout_marginStart="@dimen/_8sp"
                        android:src="@drawable/baseline_arrow_back_24" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:fontFamily="@font/poppins_medium"
                        android:text="Payment Link"
                        android:textColor="#000000"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/backButton"
                        android:textStyle="bold"
                        android:textSize="16sp" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Spacing -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="20dp" />



                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/_12sp">

                    <!-- Email Address -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:text="Select Plan"
                        android:textColor="#000000"
                        android:textSize="13sp"
                        android:layout_marginTop="@dimen/_16sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/txtOpportunity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_9sp"
                        android:background="@drawable/edit_text_bg_mdl"
                        android:fontFamily="@font/normal"
                        android:hint="Select Plan"
                        android:padding="12dp"
                        android:textSize="14sp" />

                </androidx.appcompat.widget.LinearLayoutCompat>


                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/_16sp"
                    >
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/txtPincodeMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:textStyle="normal"
                        android:visibility="gone"
                        android:layout_marginBottom="@dimen/_10sp"
                        android:text="Note: You can select Maximum"
                        android:paddingHorizontal="@dimen/_12sp"
                        android:textSize="12sp"
                        android:textColor="#B6A3A3" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/txtPincode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:textStyle="bold"
                        android:visibility="gone"
                        android:text="@string/pincode"
                        android:paddingHorizontal="@dimen/_12sp"
                        android:textSize="13sp"
                        android:textColor="#000000" />

                    <LinearLayout
                        android:id="@+id/rootLayout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:layout_marginTop="@dimen/_4sp"
                        >

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recPincodeList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:adapter="@{model.pincodeListAdapter}"
                            android:clipToPadding="false"
                            android:visibility="gone"
                            android:layout_marginStart="@dimen/_6sp"
                            android:orientation="vertical"
                            android:scrollbars="vertical"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />


                    </LinearLayout>



                    <TextView
                        android:id="@+id/txtPincodeError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pincode_is_required"
                        android:textColor="@color/red"
                        android:visibility="gone"
                        android:layout_marginTop="@dimen/_6sp"
                        android:fontFamily="@font/poppins_medium"
                        android:textSize="14sp"/>


                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/llCityState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_medium"
                            android:textStyle="bold"
                            android:text="DISTRICT NAME"
                            android:layout_marginTop="@dimen/_16sp"
                            android:textSize="13sp"
                            android:textColor="#000000" />

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/edtCity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_12sp"
                            android:background="@drawable/edt_disabled_mdl"
                            android:fontFamily="@font/normal"
                            android:textSize="14sp"
                            android:focusable="false"
                            android:inputType="number"
                            android:padding="12dp" />



                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_medium"
                            android:textStyle="bold"
                            android:layout_marginTop="@dimen/_16sp"
                            android:text="STATE"
                            android:textSize="13sp"
                            android:textColor="#000000" />

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/edtState"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_12sp"
                            android:background="@drawable/edt_disabled_mdl"
                            android:fontFamily="@font/normal"
                            android:textSize="14sp"
                            android:focusable="false"
                            android:inputType="number"
                            android:padding="12dp" />

                    </androidx.appcompat.widget.LinearLayoutCompat>



                </androidx.appcompat.widget.LinearLayoutCompat>





            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Save Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_16sp"
            android:layout_marginTop="@dimen/_15sp"
            android:layout_marginBottom="@dimen/_15sp"
            android:background="@drawable/login_button"
            android:backgroundTint="@null"
            android:layout_alignParentBottom="true"
            android:fontFamily="@font/medium"
            android:text="@string/generate_payment_link"
            android:textColor="@color/white" />
    </RelativeLayout>



</layout>
