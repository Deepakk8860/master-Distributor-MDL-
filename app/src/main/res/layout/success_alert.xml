<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">


    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/_15sp"
        app:cardElevation="0sp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/_20sp">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/_55sp"
                android:layout_height="@dimen/_55sp"
                android:layout_marginTop="@dimen/_5sp"
                android:src="@drawable/otp_success" />


            <TextView
                android:id="@+id/msg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sp"
                android:fontFamily="@font/medium"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/_3sp"
                android:maxLines="10"
                android:text="No Internet connection. Make sure WI-Fi or cellular data is turned on, then try again."
                android:textColor="#002942"
                android:textSize="@dimen/_14sp" />

            <Button
                android:id="@+id/ok"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_45sp"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_20sp"
                android:layout_marginBottom="@dimen/_5sp"
                android:background="@drawable/custom_primary_button"
                android:backgroundTint="#F86202"
                android:fontFamily="@font/medium"
                android:includeFontPadding="false"
                android:paddingStart="@dimen/_40sp"
                android:paddingEnd="@dimen/_40sp"
                android:text="OK"
                android:textColor="@color/white"
                android:textSize="@dimen/_13sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>


</LinearLayout>


