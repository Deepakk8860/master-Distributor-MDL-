<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="model"
            type="com.android.masterdistributormdl.gskDistributor.view.home.ReportEarningModel" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical"
        android:theme="@style/MaterialTheme">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#132D5F"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_12sp"
            android:paddingTop="@dimen/_15sp"

            android:paddingBottom="@dimen/_60sp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/back"
                android:layout_width="@dimen/_35sp"
                android:layout_height="@dimen/_35sp"
                android:background="@drawable/custom_trans_button"
                android:src="@drawable/arrow_left_white" />


            <TextView
                android:layout_width="0sp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_7sp"
                android:layout_weight="1"
                android:fontFamily="@font/medium"
                android:text="Earning Report"
                android:textColor="@color/white"

                android:textSize="@dimen/_16sp" />

            <com.android.masterdistributormdl.gskDistributor.utils.CornorLinearLayout
                android:id="@+id/withdraw"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_35sp"
                android:layout_marginEnd="@dimen/_15sp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_15sp"
                android:paddingEnd="@dimen/_12sp"
                app:backgroundColor="#E1E5EF"
                app:radius="@dimen/_35sp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bold"
                    android:includeFontPadding="false"
                    android:text="Withdrawal"
                    android:textColor="#1D3667"
                    android:textSize="@dimen/_13sp" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/_20sp"
                    android:layout_height="@dimen/_20sp"
                    android:layout_marginStart="@dimen/_5sp"
                    android:src="@drawable/next_comi2" />
            </com.android.masterdistributormdl.gskDistributor.utils.CornorLinearLayout>

        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/_70sp">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true">

                <com.android.masterdistributormdl.gskDistributor.utils.CornorLinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:backgroundColor="@color/white"
                    app:radiusTopLeft="@dimen/_35sp"
                    app:radiusTopRight="@dimen/_35sp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_45sp"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/_25sp"
                        android:paddingTop="@dimen/_2sp"
                        android:visibility="gone"
                        app:radiusTopLeft="@dimen/_35sp"
                        android:paddingEnd="@dimen/_25sp">


                        <TextView
                            android:id="@+id/Orders"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/bold"
                            android:gravity="center"
                            android:text="Orders"
                            android:paddingHorizontal="@dimen/_10sp"
                            android:layout_marginHorizontal="@dimen/_65sp"
                            android:layout_marginTop="@dimen/_10sp"
                            android:paddingVertical="@dimen/_4sp"
                            android:background="@drawable/background_get_otp"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_13sp" />

                        <View
                            android:layout_width="0sp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />

                        <View
                            android:layout_width="@dimen/_1sp"
                            android:layout_height="match_parent"
                            android:layout_marginTop="@dimen/_7sp"
                            android:visibility="gone"
                            android:layout_marginBottom="@dimen/_7sp"
                            android:background="#CCD2E3" />

                        <View
                            android:layout_width="0sp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/leads"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/bold"
                            android:gravity="center"
                            android:layout_marginTop="@dimen/_10sp"
                            android:layout_marginEnd="@dimen/_65sp"
                            android:text="Leads"
                            android:paddingHorizontal="@dimen/_10sp"
                            android:paddingVertical="@dimen/_4sp"
                            android:background="@drawable/background_get_otp"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_13sp" />



                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_45sp"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/_25sp"
                        android:paddingTop="@dimen/_2sp"
                        android:paddingEnd="@dimen/_25sp">


                        <TextView
                            android:id="@+id/earn"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:background="@drawable/tab_selector"
                            android:fontFamily="@font/bold"
                            android:gravity="center"
                            android:text="Settled"
                            android:textColor="#1D3667"
                            android:textSize="@dimen/_13sp" />

                        <View
                            android:layout_width="0sp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.6" />

                        <View
                            android:layout_width="@dimen/_1sp"
                            android:layout_height="match_parent"
                            android:layout_marginTop="@dimen/_7sp"
                            android:layout_marginBottom="@dimen/_7sp"
                            android:background="#CCD2E3" />

                        <View
                            android:layout_width="0sp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.6" />

                        <TextView
                            android:id="@+id/potential"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/bold"
                            android:gravity="center"
                            android:text="Potential"
                            android:textColor="#801D3667"
                            android:textSize="@dimen/_13sp" />

                        <View
                            android:layout_width="0sp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.6" />

                        <View
                            android:layout_width="@dimen/_1sp"
                            android:layout_height="match_parent"
                            android:layout_marginTop="@dimen/_7sp"
                            android:layout_marginBottom="@dimen/_7sp"
                            android:background="#CCD2E3" />

                        <View
                            android:layout_width="0sp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.6" />

                        <TextView
                            android:id="@+id/referral"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/bold"
                            android:gravity="center"
                            android:text="Lead Settled"
                            android:textColor="#801D3667"
                            android:textSize="@dimen/_13sp" />

                        <View
                            android:layout_width="0sp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.6" />


                        <View
                            android:layout_width="@dimen/_1sp"
                            android:layout_height="match_parent"
                            android:layout_marginTop="@dimen/_7sp"
                            android:layout_marginBottom="@dimen/_7sp"
                            android:background="#CCD2E3" />

                        <View
                            android:layout_width="0sp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.6" />

                        <TextView
                            android:id="@+id/leadPotential"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/bold"
                            android:gravity="center"
                            android:text="Lead Potential"
                            android:textColor="#801D3667"
                            android:textSize="@dimen/_13sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#FFF9F3"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/_20sp"
                        android:paddingTop="@dimen/_20sp"
                        android:paddingEnd="@dimen/_20sp"
                        android:paddingBottom="@dimen/_15sp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.8">

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/OutlinedBoxStyle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">


                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etStartDate"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:focusable="false"
                                        android:fontFamily="@font/normal"
                                        android:hint="From"
                                        android:importantForAutofill="no"
                                        android:inputType="textCapWords"
                                        android:paddingStart="@dimen/_12sp"
                                        android:paddingEnd="@dimen/_12sp"
                                        android:singleLine="true"
                                        android:textColor="#1D3667"
                                        android:textCursorDrawable="@drawable/color_cursor"
                                        android:textSize="@dimen/_11sp" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="@dimen/_17sp"
                                    android:layout_height="@dimen/_17sp"
                                    android:layout_gravity="center|end"
                                    android:layout_marginEnd="@dimen/_9sp"
                                    android:layout_marginBottom="@dimen/_6sp"
                                    android:src="@drawable/calender" />

                            </FrameLayout>

                            <View
                                android:layout_width="@dimen/_12sp"
                                android:layout_height="@dimen/_1sp" />

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.8">

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/OutlinedBoxStyle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">


                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etEndDate"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:focusable="false"
                                        android:fontFamily="@font/normal"
                                        android:hint="To"
                                        android:importantForAutofill="no"
                                        android:inputType="textCapWords"
                                        android:paddingStart="@dimen/_12sp"
                                        android:paddingEnd="@dimen/_12sp"
                                        android:singleLine="true"
                                        android:textColor="#1D3667"
                                        android:textCursorDrawable="@drawable/color_cursor"
                                        android:textSize="@dimen/_11sp" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="@dimen/_17sp"
                                    android:layout_height="@dimen/_17sp"
                                    android:layout_gravity="center|end"
                                    android:layout_marginEnd="@dimen/_9sp"
                                    android:layout_marginBottom="@dimen/_6sp"
                                    android:src="@drawable/calender" />

                            </FrameLayout>

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/search"
                                android:layout_width="@dimen/_27sp"
                                android:layout_height="@dimen/_27sp"
                                android:layout_gravity="center|end"
                                app:tint="#F86202"
                                android:layout_marginHorizontal="@dimen/_5sp"
                                android:layout_marginBottom="@dimen/_8sp"
                                android:src="@drawable/baseline_search_24" />

                        </LinearLayout>

                        <Button
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_45sp"
                            android:layout_marginBottom="@dimen/_5sp"
                            android:background="@drawable/login_button"
                            android:fontFamily="@font/bold"
                            android:gravity="center"
                            android:visibility="gone"
                            android:text="Search"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_14sp" />

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/edtSearch"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_45sp"
                            android:background="@drawable/search_background"
                            android:fontFamily="@font/medium"
                            android:layout_marginVertical="@dimen/_6sp"
                            android:layout_marginEnd="@dimen/_20sp"
                            android:hint="Search by Name"
                            android:visibility="gone"
                            android:drawableTint="#F86202"
                            android:drawablePadding="@dimen/_8sp"
                            android:inputType="textCapWords"
                            android:drawableStart="@drawable/baseline_search_24"
                            android:paddingStart="@dimen/_15sp"
                            android:paddingEnd="@dimen/_15sp"
                            android:singleLine="true"
                            android:textColor="#1D3667"
                            android:textColorHint="@color/gray_666666"
                            android:textCursorDrawable="@drawable/color_cursor"
                            android:textSize="13sp" />



                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adapter="@{model.reportOrderAdapter}"
                        android:clipToPadding="false"
                        android:paddingTop="@dimen/_15sp"
                        android:paddingBottom="@dimen/_60sp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="1"
                        tools:listitem="@layout/report_earn_adapter" />

                    <TextView
                        android:id="@+id/txtNoDataFound"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/no_earning_record_found"
                        android:textSize="16sp"
                        android:visibility="gone"
                        android:gravity="center"
                        android:fontFamily="@font/medium"
                        android:textColor="@color/gray_666666"/>
                </com.android.masterdistributormdl.gskDistributor.utils.CornorLinearLayout>

            </androidx.core.widget.NestedScrollView>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <LinearLayout
            android:id="@+id/downloadReport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginTop="@dimen/_5sp"
            android:layout_marginEnd="@dimen/_10sp"
            android:layout_marginBottom="@dimen/_10sp"
            android:background="@drawable/earning_circle"
            android:elevation="@dimen/_5sp"
            android:gravity="center"
            android:paddingStart="@dimen/_20sp">

            <LinearLayout

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"


                android:gravity="center"
                android:orientation="vertical"
                android:outlineProvider="bounds">

                <TextView
                    android:id="@+id/totalEarnings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bold"
                    android:includeFontPadding="false"


                    android:text="₹10,00,00"
                    android:textColor="#F86202"

                    android:textSize="@dimen/_15sp" />

                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3sp"
                    android:fontFamily="@font/normal"
                    android:includeFontPadding="false"
                    android:text="Total Earning"
                    android:textColor="#801D3667"

                    android:textSize="@dimen/_9sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="@dimen/_55sp"
                android:layout_height="@dimen/_55sp"
                android:layout_marginStart="@dimen/_10sp"
                android:background="@drawable/download_circle"
                android:gravity="center"
                android:orientation="vertical">


                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/_25sp"
                    android:layout_height="@dimen/_25sp"
                    android:src="@drawable/download" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="@dimen/_5sp"
                    android:fontFamily="@font/medium"
                    android:includeFontPadding="false"
                    android:text="Download"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_8sp" />


            </LinearLayout>

        </LinearLayout>


    </RelativeLayout>
</layout>
