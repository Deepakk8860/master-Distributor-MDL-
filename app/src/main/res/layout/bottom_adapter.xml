<layout>

    <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/click"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/_7sp"
            android:paddingTop="@dimen/_7sp"
            android:paddingEnd="@dimen/_7sp"
            android:paddingBottom="@dimen/_7sp">

            <ImageView
                android:id="@+id/image"
                android:layout_width="@dimen/_20sp"
                android:layout_height="@dimen/_20sp"
                android:src="@drawable/iv_dollar" />

            <TextView
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sp"
                android:fontFamily="@font/medium"
                android:gravity="center"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:text="Dashboard"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_9sp" />


        </androidx.appcompat.widget.LinearLayoutCompat>

        <TextView
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center|top"
            android:layout_marginStart="@dimen/_7sp"
            android:layout_marginTop="@dimen/_2sp"
            android:fontFamily="@font/medium"
            android:gravity="center"
            android:visibility="gone"
            android:paddingStart="@dimen/_3sp"
            android:paddingTop="@dimen/_2sp"
            android:paddingEnd="@dimen/_3sp"
            android:paddingBottom="@dimen/_2sp"
            android:text="101"
            android:textColor="@color/white"
            android:textSize="@dimen/_7sp" />

    </FrameLayout>

</layout>