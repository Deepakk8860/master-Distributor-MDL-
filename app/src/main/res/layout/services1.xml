<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="model"
            type="com.android.masterdistributormdl.gskDistributor.view.home.Services1Model" />
    </data>


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_150sp"
            android:background="#132D5F" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/headerLay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_15sp"
            android:paddingTop="@dimen/_20sp"

            android:paddingBottom="@dimen/_25sp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/back"
                android:layout_width="@dimen/_30sp"
                android:layout_height="@dimen/_30sp"
                android:background="@drawable/custom_trans_button"
                android:src="@drawable/arrow_left_white" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_15sp"
                android:fontFamily="@font/medium"
                android:text="Taxation &amp; Registeration"
                android:textColor="@color/white"
                android:textSize="@dimen/_16sp" />




        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/headerLay"
            android:background="@drawable/services_">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingBottom="@dimen/_8sp"
                    android:paddingStart="@dimen/_10sp"
                    android:paddingTop="@dimen/_20sp"
                    android:paddingEnd="@dimen/_10sp">

                    <TextView
                        android:layout_width="0sp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/medium"
                        android:text="Services"
                        android:textAlignment="center"
                        android:textColor="#B31D3667"
                        android:textSize="@dimen/_10sp" />

                    <TextView
                        android:layout_width="0sp"
                        android:layout_height="wrap_content"
                        android:layout_weight=".6"
                        android:fontFamily="@font/medium"
                        android:gravity="center"
                        android:text="Price\n₹"
                        android:textColor="#B31D3667"
                        android:textSize="@dimen/_10sp" />


                    <TextView
                        android:layout_width="0sp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/medium"
                        android:textAlignment="center"
                        android:paddingEnd="@dimen/_2sp"
                        android:text="Your\nCommission\n₹"
                        android:textColor="#B31D3667"
                        android:textSize="@dimen/_10sp" />



                    <TextView
                        android:layout_width="0sp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/medium"
                        android:textAlignment="center"
                        android:paddingEnd="@dimen/_2sp"
                        android:text="Distributor Commission\n₹"
                        android:textColor="#B31D3667"
                        android:textSize="@dimen/_10sp" />

                    <TextView
                        android:layout_width="0sp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/medium"
                        android:textAlignment="center"
                        android:paddingEnd="@dimen/_2sp"
                        android:text="Retailer Commission\n₹"
                        android:textColor="#B31D3667"
                        android:textSize="@dimen/_10sp" />

                    <ImageView
                        android:layout_width="@dimen/_12sp"
                        android:layout_height="@dimen/_12sp"
                        android:layout_marginTop="@dimen/_1sp"
                        android:visibility="gone"
                        android:src="@drawable/inr2" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adapter="@{model.services1Adapter}"
                    android:clipToPadding="false"
                    android:paddingBottom="@dimen/_10sp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/service1_adapter" />
            </LinearLayout>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>



    </RelativeLayout>
</layout>
