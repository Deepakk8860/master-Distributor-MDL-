<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/alert_back"
    android:orientation="vertical"
    android:padding="@dimen/_15sp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center">


        <ImageView
            android:id="@+id/cancel"
            android:layout_width="@dimen/_30sp"
            android:layout_height="@dimen/_30sp"
            android:layout_gravity="end"
            android:background="@drawable/custom_trans_button"
            android:padding="@dimen/_3sp"
            android:src="@drawable/close" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_25sp"
            android:layout_marginBottom="@dimen/_10sp"
            android:paddingStart="@dimen/_15sp"
            android:paddingEnd="@dimen/_15sp">

            <LinearLayout
                android:id="@+id/camera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/custom_trans_button"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/_10sp">

                <ImageView
                    android:layout_width="@dimen/_45sp"
                    android:layout_height="@dimen/_45sp"
                    android:src="@drawable/camera" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sp"

                    android:fontFamily="@font/medium"


                    android:text="Camera"
                    android:textColor="#132D5F"
                    android:textSize="@dimen/_14sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/gallery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/custom_trans_button"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/_10sp">

                <ImageView
                    android:layout_width="@dimen/_45sp"
                    android:layout_height="@dimen/_45sp"
                    android:src="@drawable/gallary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sp"

                    android:fontFamily="@font/medium"


                    android:text="Gallery"
                    android:textColor="#132D5F"
                    android:textSize="@dimen/_14sp" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>


</LinearLayout>
