<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="model"
            type="com.android.masterdistributormdl.gskDistributor.view.home.ProfileModel" />
    </data>


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:theme="@style/MaterialTheme">

        <LinearLayout
            android:id="@+id/topLay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#132D5F"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_15sp"
            android:paddingTop="@dimen/_15sp"

            android:paddingBottom="@dimen/_120sp">

            <ImageView
                android:id="@+id/back"
                android:layout_width="@dimen/_35sp"
                android:layout_height="@dimen/_35sp"
                android:background="@drawable/custom_trans_button"
                android:src="@drawable/arrow_left_white" />


            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_15sp"
                android:fontFamily="@font/medium"
                android:text="Profile Details"
                android:textColor="@color/white"

                android:textSize="@dimen/_16sp" />
        </LinearLayout>


        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/_60sp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingTop="@dimen/_20sp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.android.masterdistributormdl.gskDistributor.utils.CornorLinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/_45sp"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/_60sp"
                    app:backgroundColor="#F2F2F2"
                    app:radiusTopLeft="@dimen/_40sp"
                    app:radiusTopRight="@dimen/_40sp">

                    <TextView
                        android:id="@+id/name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/bold"
                        android:gravity="center"
                        android:text="Android Developer"
                        android:textColor="#132D5F"
                        android:textSize="@dimen/_16sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/_3sp"
                        android:orientation="horizontal">

                        <TextView

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:fontFamily="@font/normal"

                            android:text="Branch ID: "
                            android:textColor="#CC132D5F"
                            android:textSize="@dimen/_12sp" />

                        <TextView
                            android:id="@+id/branchId"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:fontFamily="@font/bold"

                            android:text="32165498"
                            android:textColor="#1D3667"
                            android:textSize="@dimen/_12sp" />

                    </LinearLayout>


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sp"
                        android:layout_marginTop="@dimen/_15sp"
                        android:background="#1A1D3667" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/_20sp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:gravity="center|start">

                            <ImageView
                                android:layout_width="@dimen/_20sp"
                                android:layout_height="@dimen/_20sp"
                                android:src="@drawable/email_" />

                            <TextView
                                android:id="@+id/email"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_10sp"
                                android:fontFamily="@font/medium"
                                android:includeFontPadding="false"
                                android:text="yamini.singh@gmail.com"
                                android:textColor="#E61D3667"
                                android:textSize="@dimen/_13sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/altEmailLay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_15sp"
                            android:gravity="center|start">

                            <ImageView
                                android:layout_width="@dimen/_20sp"
                                android:layout_height="@dimen/_20sp"
                                android:src="@drawable/email_" />

                            <TextView
                                android:id="@+id/altEmail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_10sp"
                                android:fontFamily="@font/medium"
                                android:includeFontPadding="false"
                                android:text="yamini.singh@gmail.com"
                                android:textColor="#E61D3667"
                                android:textSize="@dimen/_13sp" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_1sp"
                            android:layout_marginTop="@dimen/_15sp"
                            android:background="#1A1D3667" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_20sp"
                            android:gravity="center|start">

                            <ImageView
                                android:layout_width="@dimen/_20sp"
                                android:layout_height="@dimen/_20sp"
                                android:src="@drawable/call_" />

                            <TextView
                                android:id="@+id/mobile"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:fontFamily="@font/medium"
                                android:includeFontPadding="false"
                                android:paddingStart="@dimen/_12sp"
                                android:text="91- 9876543210"
                                android:textColor="#E61D3667"
                                android:textSize="@dimen/_13sp" />

                            <LinearLayout
                                android:id="@+id/altMobileLay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_5sp"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/normal"
                                    android:includeFontPadding="false"
                                    android:text="/"
                                    android:textColor="#CCD2E3"
                                    android:textSize="@dimen/_15sp" />

                                <TextView
                                    android:id="@+id/altMobile"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/_5sp"
                                    android:fontFamily="@font/medium"
                                    android:includeFontPadding="false"
                                    android:text="91- 9876543210"
                                    android:textColor="#1D3667"
                                    android:textSize="@dimen/_13sp" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sp"
                        android:layout_marginStart="@dimen/_20sp"
                        android:layout_marginEnd="@dimen/_20sp"
                        android:background="#1A1D3667" />


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:orientation="vertical"
                        android:padding="@dimen/_20sp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:orientation="vertical">

                            <TextView

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:fontFamily="@font/normal"
                                android:includeFontPadding="false"
                                android:text="Gender"
                                android:textColor="#B31D3667"
                                android:textSize="@dimen/_11sp" />

                            <TextView
                                android:id="@+id/gender"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_3sp"
                                android:fontFamily="@font/medium"
                                android:includeFontPadding="false"
                                android:text="Female"
                                android:textColor="#1D3667"
                                android:textSize="@dimen/_13sp" />


                            <TextView

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_15sp"
                                android:fontFamily="@font/normal"
                                android:includeFontPadding="false"
                                android:text="License Name"
                                android:textColor="#B31D3667"
                                android:textSize="@dimen/_11sp" />

                            <TextView
                                android:id="@+id/license"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_3sp"
                                android:fontFamily="@font/medium"
                                android:includeFontPadding="false"
                                android:text="yamini general store"
                                android:textColor="#1D3667"
                                android:textSize="@dimen/_13sp" />

                        </LinearLayout>


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_20sp"

                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView

                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"

                                    android:fontFamily="@font/normal"
                                    android:includeFontPadding="false"
                                    android:text="Date of Birth"
                                    android:textColor="#B31D3667"
                                    android:textSize="@dimen/_11sp" />


                                <TextView
                                    android:id="@+id/dob"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_3sp"
                                    android:fontFamily="@font/medium"
                                    android:includeFontPadding="false"
                                    android:text="11/10/1992"
                                    android:textColor="#1D3667"
                                    android:textSize="@dimen/_13sp" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView

                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"

                                    android:fontFamily="@font/normal"
                                    android:includeFontPadding="false"
                                    android:text="Registration Date"
                                    android:textColor="#B31D3667"
                                    android:textSize="@dimen/_11sp" />

                                <TextView
                                    android:id="@+id/r_date"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_3sp"
                                    android:fontFamily="@font/medium"
                                    android:includeFontPadding="false"

                                    android:text="11/10/2018"
                                    android:textColor="#1D3667"
                                    android:textSize="@dimen/_13sp" />

                            </LinearLayout>

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_1sp"
                            android:layout_marginTop="@dimen/_15sp"
                            android:background="#1A1D3667" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_15sp"
                            android:gravity="center|start">

                            <ImageView
                                android:layout_width="@dimen/_22sp"
                                android:layout_height="@dimen/_22sp"
                                android:src="@drawable/shop_add" />


                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingStart="@dimen/_12sp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"

                                    android:fontFamily="@font/normal"
                                    android:includeFontPadding="false"
                                    android:text="Office Address"
                                    android:textColor="#B31D3667"
                                    android:textSize="@dimen/_11sp" />

                                <TextView
                                    android:id="@+id/office_add"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_2sp"
                                    android:fontFamily="@font/medium"
                                    android:includeFontPadding="false"
                                    android:text="H-183 Noida Sector 63 -(UP) 201301,"
                                    android:textColor="#1D3667"
                                    android:textSize="@dimen/_13sp" />
                            </LinearLayout>

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_1sp"
                            android:layout_marginTop="@dimen/_15sp"
                            android:background="#1A1D3667" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_20sp"
                            android:gravity="center|start">

                            <ImageView
                                android:layout_width="@dimen/_22sp"
                                android:layout_height="@dimen/_22sp"
                                android:src="@drawable/home_add" />


                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingStart="@dimen/_12sp">

                                <TextView

                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"

                                    android:fontFamily="@font/normal"
                                    android:includeFontPadding="false"
                                    android:text="Home Address"
                                    android:textColor="#B31D3667"
                                    android:textSize="@dimen/_11sp" />

                                <TextView
                                    android:id="@+id/home_add"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_2sp"
                                    android:fontFamily="@font/medium"
                                    android:includeFontPadding="false"
                                    android:text="H-183 Noida Sector 63 -(UP) 201301,"
                                    android:textColor="#1D3667"
                                    android:textSize="@dimen/_13sp" />
                            </LinearLayout>

                        </LinearLayout>


                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_1sp"
                            android:layout_marginTop="@dimen/_15sp"
                            android:background="#1A1D3667" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_20sp"
                            android:gravity="center|start">

                            <ImageView
                                android:layout_width="@dimen/_22sp"
                                android:layout_height="@dimen/_22sp"
                                android:src="@drawable/baseline_location_on_24" />


                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingStart="@dimen/_12sp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/normal"
                                    android:includeFontPadding="false"
                                    android:text="Territory"
                                    android:textColor="#B31D3667"
                                    android:textSize="@dimen/_11sp" />

                                <TextView
                                    android:id="@+id/home_territory"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_2sp"
                                    android:fontFamily="@font/medium"
                                    android:includeFontPadding="false"
                                    android:text="India"
                                    android:textColor="#1D3667"
                                    android:textSize="@dimen/_13sp" />
                            </LinearLayout>

                        </LinearLayout>


                    </LinearLayout>


                </com.android.masterdistributormdl.gskDistributor.utils.CornorLinearLayout>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/image"
                    android:layout_width="@dimen/_90sp"
                    android:layout_height="@dimen/_90sp"
                    android:layout_centerHorizontal="true"
                    android:src="@drawable/logo"
                    app:shapeAppearance="@style/CornerSize50Percent" />

            </RelativeLayout>

        </androidx.core.widget.NestedScrollView>


    </RelativeLayout>
</layout>
