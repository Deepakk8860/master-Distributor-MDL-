<layout>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/click"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/_7sp"
        android:paddingTop="@dimen/_7sp"
        android:paddingEnd="@dimen/_7sp"
        android:paddingBottom="@dimen/_7sp">

        <ImageView
            android:id="@+id/image"
            android:layout_width="@dimen/_20sp"
            android:layout_height="@dimen/_20sp"
            android:src="@drawable/iv_dollar" />

        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sp"
            android:fontFamily="@font/medium"
            android:gravity="center"
            android:includeFontPadding="false"

            android:text="Dashboard"
            android:textColor="#801D3667"
            android:textSize="@dimen/_9sp" />


    </LinearLayout>

</layout>