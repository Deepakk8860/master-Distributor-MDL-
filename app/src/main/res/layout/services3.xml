<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="model"
            type="com.android.masterdistributormdl.gskDistributor.view.home.Services1Model" />
    </data>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#132D5F"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_15sp"
            android:paddingTop="@dimen/_20sp"
            android:paddingEnd="@dimen/_15sp"
            android:paddingBottom="@dimen/_65sp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/back"
                android:layout_width="@dimen/_30sp"
                android:layout_height="@dimen/_30sp"
                android:background="@drawable/custom_trans_button"
                android:src="@drawable/arrow_left_white" />


            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_15sp"
                android:fontFamily="@font/medium"
                android:lineSpacingExtra="@dimen/_3sp"
                android:text="Other Services"

                android:textColor="@color/white"

                android:textSize="@dimen/_16sp" />
        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/_minus30sp"
            android:background="@drawable/services_">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/_20sp">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/_20sp"
                        android:paddingEnd="@dimen/_20sp">

                        <TextView
                            android:id="@+id/txtServices"
                            android:layout_width="0sp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/normal"
                            android:textAlignment="center"
                            android:includeFontPadding="false"
                            android:text="Services"
                            android:textColor="#66132D5F"
                            android:textSize="@dimen/_10sp" />
                        <TextView
                            android:id="@+id/txtAmount"
                            android:layout_width="0sp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/normal"
                            android:textAlignment="center"
                            android:includeFontPadding="false"
                            android:text="Price\n₹"
                            android:textColor="#66132D5F"
                            android:textSize="@dimen/_10sp" />

                        <TextView
                            android:id="@+id/txtCost"
                            android:layout_width="0sp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/normal"
                            android:textAlignment="center"
                            android:includeFontPadding="false"
                            android:text="Your\nCommission\n₹"
                            android:textColor="#66132D5F"
                            android:textSize="@dimen/_10sp" />

                        <TextView
                            android:id="@+id/txtCommission"
                            android:layout_width="0sp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAlignment="center"
                            android:fontFamily="@font/normal"
                            android:includeFontPadding="false"
                            android:text="Retailer\nCommission\n₹"
                            android:textColor="#66132D5F"
                            android:textSize="@dimen/_10sp" />

                        <TextView
                            android:id="@+id/txtDistCommission"
                            android:layout_width="0sp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAlignment="center"
                            android:fontFamily="@font/normal"
                            android:includeFontPadding="false"
                            android:text="Distributor\nCommission\n₹"
                            android:textColor="#66132D5F"
                            android:textSize="@dimen/_10sp" />



                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adapter="@{model.services1Adapter}"
                        android:clipToPadding="false"
                        android:paddingBottom="@dimen/_10sp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/service3_adapter" />
                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>


    </LinearLayout>
</layout>
