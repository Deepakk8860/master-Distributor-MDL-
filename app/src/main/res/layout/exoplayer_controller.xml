<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#73054070"
        android:layoutDirection="ltr"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="@dimen/_10sp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <ImageView
                    android:id="@id/exo_play"
                    android:layout_width="@dimen/_30sp"
                    android:layout_height="@dimen/_30sp"

                    android:src="@drawable/ic_play_circle" />

                <ImageView
                    android:id="@id/exo_pause"
                    android:layout_width="@dimen/_30sp"
                    android:layout_height="@dimen/_30sp"
                    android:src="@drawable/ic_pause_circle" />
            </LinearLayout>


            <ImageView
                android:id="@id/exo_fullscreen"
                android:layout_width="@dimen/_30sp"
                android:layout_height="@dimen/_30sp"
                android:layout_gravity="end"
                android:layout_marginEnd="@dimen/_5sp"
                android:background="@drawable/custom_trans_button"
                android:src="@drawable/ic_fullscreen" />

            <ImageView
                android:id="@id/exo_minimal_fullscreen"
                android:layout_width="@dimen/_30sp"
                android:layout_height="@dimen/_30sp"
                android:layout_gravity="end"
                android:layout_marginEnd="@dimen/_5sp"
                android:background="@drawable/custom_trans_button"
                android:src="@drawable/ic_fullscreen_exit" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sp"
            android:layout_marginTop="@dimen/_2sp"
            android:layout_marginEnd="@dimen/_8sp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/medium"
                android:includeFontPadding="false"
                android:text="00:00"
                android:textColor="@color/white"
                android:textSize="@dimen/_10sp" />



            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/medium"
                android:includeFontPadding="false"
                android:text="00:00"
                android:textColor="@color/white"
                android:textSize="@dimen/_10sp" />

        </LinearLayout>
    </LinearLayout>

</layout>
