<com.android.masterdistributormdl.gskDistributor.utils.CornorLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:gravity="center"
    android:orientation="vertical"
    android:theme="@style/MaterialTheme"
    app:backgroundColor="@color/white"
    app:radiusTopLeft="@dimen/_40sp"
    app:radiusTopRight="@dimen/_40sp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_20sp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/bold"
                android:text="Buy Retailer Quota "
                android:textColor="#132D5F"
                android:textSize="@dimen/_16sp" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/close"
                android:layout_width="@dimen/_22sp"
                android:layout_height="@dimen/_22sp"
                android:layout_gravity="end"
                android:background="@drawable/custom_trans_button"

                android:src="@drawable/close" />

        </LinearLayout>

        <TextView
            android:id="@+id/startShop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sp"
            android:layout_weight="1"
            android:fontFamily="@font/normal"
            android:text="@string/shop_quota_price"
            android:textColor="#CC132D5F"
            android:textSize="@dimen/_13sp" />

        <TextView
            android:id="@+id/call_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sp"
            android:layout_weight="1"
            android:fontFamily="@font/normal"
            android:visibility="gone"
            android:background="@drawable/custom_trans_button"
            android:text="Call 18005711888 to purchase Retailers"
            android:textColor="#CC132D5F"
            android:textSize="@dimen/_13sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/etInputLay"
                style="@style/OutlinedBoxStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/normal"
                    android:hint="@string/enter_retailer_quota"
                    android:inputType="number"
                    android:maxLength="5"
                    android:paddingStart="@dimen/_15sp"
                    android:paddingEnd="@dimen/_15sp"
                     android:maxLines="1"
                    android:textColor="#1D3667"
                    android:textCursorDrawable="@drawable/color_cursor"
                    android:textSize="@dimen/_12sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/apply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/_29sp"
                android:layout_marginEnd="@dimen/_7sp"
                android:visibility="gone"
                android:fontFamily="@font/medium"
                android:padding="@dimen/_5sp"
                android:text="Apply"
                android:textColor="#4D132D5F"

                android:textSize="@dimen/_12sp" />

        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/medium"
            android:text="@string/or"
            android:gravity="center"
            android:layout_marginTop="@dimen/_5sp"
            android:textColor="#CC132D5F"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/normal"
            android:layout_marginTop="@dimen/_15sp"
            android:text="Choose a Retailer Quota that suits you the best"
            android:textColor="#CC132D5F"
            android:textSize="@dimen/_12sp" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_20sp"
        android:orientation="vertical"
        android:paddingStart="@dimen/_15sp"
        android:paddingEnd="@dimen/_15sp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="5"
        tools:itemCount="5"
        tools:listitem="@layout/default_quota_adapter" />


    <LinearLayout
        android:id="@+id/amountLay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sp"
            android:background="#EFEFEF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_20sp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/medium"
                    android:text="Retailer : "
                    android:textColor="#E61F3868"
                    android:textSize="@dimen/_13sp" />

                <TextView

                    android:id="@+id/shopCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:fontFamily="@font/bold"


                    android:text="12"
                    android:textColor="#25233C"
                    android:textSize="@dimen/_13sp" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/medium"
                    android:text="Retailer Amount :"
                    android:textColor="#E61F3868"
                    android:textSize="@dimen/_13sp" />

                <TextView

                    android:id="@+id/shopAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:fontFamily="@font/bold"


                    android:text="₹10,140"
                    android:textColor="#F86202"
                    android:textSize="@dimen/_13sp" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/medium"
                    android:text="GST :"
                    android:textColor="#E61F3868"
                    android:textSize="@dimen/_13sp" />

                <TextView

                    android:id="@+id/gstAmount"
                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bold"


                    android:text="₹10,140"
                    android:textColor="#F86202"
                    android:textSize="@dimen/_13sp" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/medium"
                    android:text="Gateway Charge :"
                    android:textColor="#E61F3868"
                    android:textSize="@dimen/_13sp" />

                <TextView

                    android:id="@+id/gatewayAmount"
                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bold"


                    android:text="₹10,140"
                    android:textColor="#F86202"
                    android:textSize="@dimen/_13sp" />


            </LinearLayout>

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50sp"
            android:layout_marginTop="@dimen/_5sp">

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_1sp"
                android:background="#4DF4A11E" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_1sp"
                android:layout_gravity="bottom"
                android:background="#4DF4A11E" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/totalPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/medium"
                        android:text="₹10,140"
                        android:textColor="#F86202"
                        android:textSize="@dimen/_14sp" />

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sp"

                        android:fontFamily="@font/normal"


                        android:text="Total Amount"
                        android:textColor="#B31D3667"
                        android:textSize="@dimen/_10sp" />

                </LinearLayout>

                <com.android.masterdistributormdl.gskDistributor.utils.CornorLinearLayout
                    android:id="@+id/purchase"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    app:backgroundColor="#F86202"
                    app:radiusTopLeft="@dimen/_40sp">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/medium"
                        android:text="Purchase"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_15sp" />


                </com.android.masterdistributormdl.gskDistributor.utils.CornorLinearLayout>

            </androidx.appcompat.widget.LinearLayoutCompat>
        </FrameLayout>
    </LinearLayout>


</com.android.masterdistributormdl.gskDistributor.utils.CornorLinearLayout>
