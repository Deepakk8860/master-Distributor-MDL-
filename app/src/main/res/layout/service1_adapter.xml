<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <FrameLayout
        android:id="@+id/clickLay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sp"
        android:layout_marginBottom="@dimen/_5sp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_12sp"
            android:background="@color/white"
            android:orientation="vertical"
            android:paddingStart="@dimen/_10sp"
            android:paddingTop="@dimen/_7sp"
            android:paddingEnd="@dimen/_8sp"
            android:paddingBottom="@dimen/_10sp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/editPrice"
                android:layout_width="@dimen/_20sp"
                android:layout_height="@dimen/_20sp"
                android:layout_gravity="end"
                android:visibility="gone"
                android:background="@drawable/custom_trans_button"
                android:src="@drawable/edit_service" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/name"
                    android:layout_width="0sp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/bold"
                    android:textAlignment="center"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="@dimen/_3sp"
                    android:paddingEnd="@dimen/_5sp"
                    android:text="GST Registration -Proprietorship"
                    android:textColor="#1D3667"
                    android:textSize="@dimen/_10sp" />


                <LinearLayout
                    android:layout_width="0sp"
                    android:layout_height="match_parent"
                    android:layout_weight=".6"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/customerPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/bold"
                        android:includeFontPadding="false"
                        android:text="₹600"
                        android:textColor="#132D5F"
                        android:textSize="@dimen/_10sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/shopComi"
                    android:layout_width="0sp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/bold"
                    android:gravity="end|center"
                    android:textAlignment="center"
                    android:includeFontPadding="false"
                    android:text="Your\nCommission"
                    android:textColor="#132D5F"
                    android:textSize="@dimen/_10sp" />

                <TextView
                    android:id="@+id/distComi"
                    android:layout_width="0sp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/bold"
                    android:gravity="end|center"
                    android:textAlignment="center"
                    android:includeFontPadding="false"
                    android:text="Distributor\nCommission"
                    android:textColor="#132D5F"
                    android:textSize="@dimen/_10sp" />

                <TextView
                    android:id="@+id/retailerComi"
                    android:layout_width="0sp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/bold"
                    android:gravity="end|center"
                    android:textAlignment="center"
                    android:includeFontPadding="false"
                    android:text="Retailer\nCommission"
                    android:textColor="#132D5F"
                    android:textSize="@dimen/_10sp" />




            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_1sp"
                android:visibility="gone"
                android:layout_marginTop="@dimen/_15sp"
                android:layout_marginBottom="@dimen/_12sp"
                android:background="#1A1D3667" />

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_12sp"
                android:visibility="gone"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/yourComi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/black"

                    android:text="₹100,00"
                    android:textColor="#F86202"

                    android:textSize="@dimen/_14sp" />

                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_1sp"
                    android:fontFamily="@font/normal"
                    android:text="Your Commission"
                    android:textColor="#E6F86202"

                    android:textSize="@dimen/_10sp" />

            </LinearLayout>

            <FrameLayout
                android:id="@+id/detailClick1"
                android:layout_width="match_parent"
                android:visibility="gone"
                android:layout_height="wrap_content">

                <View
                    android:id="@+id/line2"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sp"
                    android:layout_gravity="center"
                    android:background="#1A1D3667" />

                <com.android.masterdistributormdl.gskDistributor.utils.CornorLinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:paddingStart="@dimen/_12sp"
                    android:paddingTop="@dimen/_7sp"
                    android:paddingEnd="@dimen/_12sp"
                    android:paddingBottom="@dimen/_7sp"
                    app:backgroundColor="#FAFAFA"
                    app:radius="@dimen/_12sp"
                    app:strokeColor="#E4E6EB"
                    app:strokeWidth="@dimen/_1sp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/bold"
                        android:includeFontPadding="false"
                        android:text="Detail"
                        android:textColor="#132D5F"
                        android:textSize="@dimen/_10sp" />

                    <androidx.appcompat.widget.AppCompatImageView

                        android:layout_width="@dimen/_12sp"
                        android:layout_height="@dimen/_12sp"
                        android:layout_marginStart="@dimen/_4sp"

                        android:src="@drawable/service_down" />


                </com.android.masterdistributormdl.gskDistributor.utils.CornorLinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/moreLay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginTop="@dimen/_10sp"
                android:layout_marginBottom="@dimen/_10sp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"

                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/basePrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/bold"

                        android:text="₹100,00"
                        android:textColor="#132D5F"

                        android:textSize="@dimen/_16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sp"
                        android:fontFamily="@font/normal"
                        android:text="Base Price"
                        android:textColor="#B31D3667"

                        android:textSize="@dimen/_10sp" />

                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/shopYou"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/bold"
                        android:text="₹100,00"
                        android:textColor="#132D5F"
                        android:textSize="@dimen/_16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sp"
                        android:fontFamily="@font/normal"
                        android:text="Retailer+You"
                        android:textColor="#B31D3667"

                        android:textSize="@dimen/_10sp" />

                </LinearLayout>


            </LinearLayout>


        </LinearLayout>

        <com.android.masterdistributormdl.gskDistributor.utils.CornorLinearLayout
            android:id="@+id/detailClick2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center"
            android:layout_marginTop="@dimen/_15sp"
            android:gravity="center"
            android:paddingStart="@dimen/_12sp"
            android:visibility="gone"
            android:paddingTop="@dimen/_7sp"
            android:paddingEnd="@dimen/_12sp"
            android:paddingBottom="@dimen/_7sp"
            app:backgroundColor="#FAFAFA"
            app:radius="@dimen/_12sp"
            app:strokeColor="#E4E6EB"
            app:strokeWidth="@dimen/_1sp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bold"
                android:includeFontPadding="false"
                android:text="Detail"
                android:textColor="#132D5F"
                android:textSize="@dimen/_10sp" />

            <androidx.appcompat.widget.AppCompatImageView

                android:layout_width="@dimen/_12sp"
                android:layout_height="@dimen/_12sp"
                android:layout_marginStart="@dimen/_4sp"
                android:rotation="180"
                android:src="@drawable/service_down" />


        </com.android.masterdistributormdl.gskDistributor.utils.CornorLinearLayout>

    </FrameLayout>

</layout>
