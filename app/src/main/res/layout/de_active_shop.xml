<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="model"
            type="com.android.masterdistributormdl.gskDistributor.view.home.DeactiveShopModel" />
    </data>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical"
        android:theme="@style/MaterialTheme">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_10sp"
            android:paddingTop="@dimen/_15sp"

            android:paddingBottom="@dimen/_10sp">

            <ImageView
                android:id="@+id/back"
                android:layout_width="@dimen/_35sp"
                android:layout_height="@dimen/_35sp"
                android:background="@drawable/custom_trans_button"
                android:src="@drawable/arrow_left" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_15sp"
                android:fontFamily="@font/medium"
                android:text="Deactivate Retailer"
                android:textColor="#1D3667"

                android:textSize="@dimen/_16sp" />
        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"

                    android:layout_height="@dimen/_45sp"
                    android:layout_marginStart="@dimen/_20sp"
                    android:layout_marginTop="@dimen/_8sp"
                    android:layout_marginEnd="@dimen/_20sp"
                    android:layout_marginBottom="@dimen/_8sp"
                    android:theme="@style/Theme.MaterialComponents.DayNight.DarkActionBar"
                    app:cardBackgroundColor="#FAFAFA"
                    app:cardCornerRadius="@dimen/_5sp"
                    app:cardElevation="0sp"
                    app:strokeColor="#CCD2E3"
                    app:strokeWidth="@dimen/_1sp">

                    <EditText
                        android:id="@+id/search"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/trans"
                        android:hint="Search by Retailer"
                        android:inputType="textCapWords"

                        android:paddingStart="@dimen/_15sp"
                        android:singleLine="true"
                        android:textColor="#1D3667"
                        android:textColorHint="#661D3667"
                        android:textCursorDrawable="@drawable/color_cursor"
                              android:textSize="@dimen/_14sp" />

                    <ImageView
                        android:layout_width="@dimen/_22sp"
                        android:layout_height="@dimen/_22sp"
                        android:layout_gravity="end|center"
                        android:layout_marginEnd="@dimen/_10sp"
                        android:src="@drawable/search" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/hintLay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_20sp"
                    android:layout_marginTop="@dimen/_8sp"
                    android:layout_marginEnd="@dimen/_20sp"
                    android:layout_marginBottom="@dimen/_8sp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/medium"
                        android:text="Select Retailer you wish to deactivate"
                        android:textColor="#1B2F56"

                        android:textSize="@dimen/_13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sp"
                        android:fontFamily="@font/normal"
                        android:lineSpacingExtra="@dimen/_9sp"
                        android:text="Search By Mobile\nSearch By Retailer Name\nSearch by Contact Person Name\nSearch by Retailer ID"
                        android:textColor="#661D3667"

                        android:textSize="@dimen/_13sp" />


                </LinearLayout>


                <androidx.recyclerview.widget.RecyclerView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adapter="@{model.shopDeactiveAdapter}"
                    android:background="@color/white"
                    android:clipToPadding="false"
                    android:paddingTop="@dimen/_10sp"
                    android:paddingBottom="@dimen/_10sp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/shop_adapter" />
            </LinearLayout>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>


    </LinearLayout>
</layout>
