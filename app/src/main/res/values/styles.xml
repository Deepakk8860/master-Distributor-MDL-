    <style name="CustomSearchViewStyle" parent="Widget.AppCompat.SearchView">
        <item name="android:queryHint">Search Banks</item>
        <item name="android:submitBackground">@android:color/transparent</item>
        <item name="android:closeIcon">@drawable/ic_close_otp</item> <!-- Customize the close icon if needed -->
        <item name="android:searchIcon">@drawable/ic_search_icon</item>
        <item name="android:searchHintIcon">@null</item>
        <item name="android:queryBackground">@drawable/edt_normal3</item>
    </style>

